posix_spawn's test also checks posix_spawn_file_actions_addfchdir,
whose child calls fchdir. Radix has no fchdir yet, since a descriptor
does not know its path (docs/design/posix.md, Known limits), so the
test leaves that part out there; every other part runs.

diff --git a/tests/posix/posix_spawn.c b/tests/posix/posix_spawn.c
index df6a55c..4b55dd5 100644
--- a/tests/posix/posix_spawn.c
+++ b/tests/posix/posix_spawn.c
@@ -493,7 +493,12 @@ int main(int argc, char *argv[]) {
 	test_file_actions(argv[0]);
 	test_attributes(argv[0]);
 	test_chdir(argv[0]);
+#ifndef __radix__
 	test_fchdir(argv[0]);
+#else
+	// Radix has no fchdir yet: a descriptor does not know its path.
+	(void)test_fchdir;
+#endif
 	test_setpgroup(argv[0]);
 	return 0;
 }
