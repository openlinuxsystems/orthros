+/// Returns the -column and +page arguments, which `recreate_arguments`
+/// removes, so that a file name such as `notes-2` is not taken for one.
+fn column_page_arguments(args: &[String]) -> String {
+    let column_page_option = Regex::new(r"^[-+]\d+.*").unwrap();
+    args.iter()
+        .filter(|i| column_page_option.is_match(i))
+        .join(" ")
+}
