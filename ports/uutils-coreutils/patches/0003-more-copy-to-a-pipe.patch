+/// Copies `input` to standard output as it is: after util-linux's
+/// header naming the file when there are several, and with runs of
+/// blank lines squeezed to one for `-s`.
+fn copy_whole(
+    mut input: Input,
+    multiple_file: bool,
+    file_name: Option<&str>,
+    squeeze: bool,
+) -> UResult<()> {
+    let mut out = stdout().lock();
+    if let (true, Some(name)) = (multiple_file, file_name) {
+        writeln!(out, "::::::::::::::\n{name}\n::::::::::::::")?;
+    }
+    let mut line = Vec::new();
+    let mut after_blank = false;
+    loop {
+        line.clear();
+        if input.read_bytes_line(&mut line)? == 0 {
+            break;
+        }
+        let blank = line == b"\n";
+        if squeeze && blank && after_blank {
+            continue;
+        }
+        after_blank = blank;
+        out.write_all(&line)?;
+    }
+    out.flush()?;
+    Ok(())
+}
