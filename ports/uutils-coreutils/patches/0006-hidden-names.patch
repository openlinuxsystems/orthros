+/// The names `dir/.hidden` lists, one a line, as GNOME Files reads them.
+#[cfg(target_os = "radix")]
+fn hidden_names(dir: &Path) -> FxHashSet<OsString> {
+    use std::os::unix::ffi::OsStrExt;
+    let Ok(text) = fs::read(dir.join(".hidden")) else {
+        return FxHashSet::default();
+    };
+    text.split(|&b| b == b'\n')
+        .filter(|line| !line.is_empty())
+        .map(|line| OsStr::from_bytes(line).to_os_string())
+        .collect()
+}
