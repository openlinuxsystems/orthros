+
+/// Makes `dest` share `source`'s data, with Linux's FICLONE, which Radix
+/// takes for files of one Btrfs filesystem (ADR 0139).
+#[cfg(target_os = "radix")]
+fn clone(source: &Path, dest: &Path, nofollow: bool) -> std::io::Result<()> {
+    use std::os::fd::AsRawFd;
+    const FICLONE: libc::Ioctl = 0x4004_9409;
+    let src_file = open_source(source, nofollow)?;
+    let dst_file = create_dest_restrictive(dest, false)?;
+    // SAFETY: FICLONE takes the source's descriptor as its argument.
+    if unsafe { libc::ioctl(dst_file.as_raw_fd(), FICLONE, src_file.as_raw_fd()) } == 0 {
+        Ok(())
+    } else {
+        Err(std::io::Error::last_os_error())
+    }
+}
