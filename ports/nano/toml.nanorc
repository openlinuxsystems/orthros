## Syntax highlighting for TOML files, as Spark's service files
## (service.toml(5)) and the copy of one `service edit` opens. nano has
## none of its own; this one is Dukovo's (ADR 0216).

syntax toml "\.toml(\.edit)?$"
comment "#"

# Tables and arrays of tables:
color bold,lagoon "^[[:blank:]]*\[\[?[^]#]*\]\]?"

# Keys, bare, quoted or dotted:
color lightgreen "^[[:blank:]]*("[^"]*"|'[^']*'|[A-Za-z0-9_-]+)([[:blank:]]*\.[[:blank:]]*("[^"]*"|'[^']*'|[A-Za-z0-9_-]+))*[[:blank:]]*="
color normal "="

# Values (booleans, numbers, dates and times):
color lightmagenta "\<(true|false)\>"
color lightmagenta "(^|[^[:alnum:]_.-])[+-]?(0x[[:xdigit:]_]+|0o[0-7_]+|0b[01_]+|[0-9][0-9_]*(\.[0-9_]+)?([eE][+-]?[0-9_]+)?|inf|nan)\>"
color lightmagenta "\<[0-9]{4}-[0-9]{2}-[0-9]{2}([Tt ][0-9]{2}:[0-9]{2}(:[0-9]{2}(\.[0-9]+)?)?)?(Z|[+-][0-9]{2}:[0-9]{2})?"
color lightmagenta "\<[0-9]{2}:[0-9]{2}:[0-9]{2}(\.[0-9]+)?\>"

# Strings, basic and literal, on one line or many:
color yellow ""([^"\]|\\.)*"|'[^']*'"
color yellow start=""""" end="""""
color yellow start="'''" end="'''"

# Escaped characters:
color orange "\\([btnfr"\]|u[[:xdigit:]]{4}|U[[:xdigit:]]{8})"

# Mistakes (control codes, trailing space):
color ,red "[[:cntrl:]]|[[:blank:]]+$"

# Comments:
color italic,cyan "(^|[[:blank:]])#.*"
