# The system's settings for git (git-config(1)), which each user's
# ~/.gitconfig and each repository's own may change. Spark puts this
# file in /system/settings at boot, where git reads it (ADR 0287).

[init]
	# A new repository's first branch, without the hint that asks.
	defaultBranch = main
[help]
	# A mistyped command is shown with the one meant, and runs only
	# when asked.
	autocorrect = prompt
[diff]
	# Moved lines are shown as moved, and the diff of a change reads
	# as it was made.
	colorMoved = default
	algorithm = histogram
[merge]
	# A conflict shows the text both sides started from.
	conflictStyle = zdiff3
[rerere]
	# A conflict resolved once is resolved again the same way.
	enabled = true
[fetch]
	prune = true
[push]
	# A new branch's first push sets where it goes.
	autoSetupRemote = true
[branch]
	sort = -committerdate
[tag]
	sort = version:refname
[credential]
	# A token or password typed for an https:// remote is kept in
	# memory, by git credential-cache, for 8 hours, and never written
	# to disk (ADR 0292). The keyring takes over in Phase 13g.
	helper = cache --timeout=28800
[include]
	# Diff, status and branch colours from Nukesh's colors.toml, and
	# diffs shown with the words that changed marked, which each shell
	# writes here (ADR 0293). A user's ~/.gitconfig wins over them.
	path = ~/.local/state/nukesh/gitconfig
