+const fn CMSG_ALIGN(len: usize) -> usize {
+    (len + size_of::<usize>() - 1) & !(size_of::<usize>() - 1)
+}
+
+f! {
+    pub unsafe fn CMSG_FIRSTHDR(mhdr: *const crate::msghdr) -> *mut crate::cmsghdr {
+        if (*mhdr).msg_controllen as usize >= size_of::<crate::cmsghdr>() {
+            (*mhdr).msg_control.cast()
+        } else {
+            core::ptr::null_mut()
+        }
+    }
+
+    pub unsafe fn CMSG_NXTHDR(
+        mhdr: *const crate::msghdr,
+        cmsg: *const crate::cmsghdr,
+    ) -> *mut crate::cmsghdr {
+        if ((*cmsg).cmsg_len as usize) < size_of::<crate::cmsghdr>() {
+            return core::ptr::null_mut();
+        }
+        let next = (cmsg as usize + CMSG_ALIGN((*cmsg).cmsg_len as usize)) as *mut crate::cmsghdr;
+        let max = (*mhdr).msg_control as usize + (*mhdr).msg_controllen as usize;
+        if (next.offset(1)) as usize > max
+            || next as usize + CMSG_ALIGN((*next).cmsg_len as usize) > max
+        {
+            core::ptr::null_mut()
+        } else {
+            next
+        }
+    }
+
+    pub unsafe fn CMSG_DATA(cmsg: *const crate::cmsghdr) -> *mut c_uchar {
+        cmsg.offset(1) as *mut c_uchar
+    }
+
+    pub const unsafe fn CMSG_SPACE(length: c_uint) -> c_uint {
+        (CMSG_ALIGN(length as usize) + CMSG_ALIGN(size_of::<crate::cmsghdr>())) as c_uint
+    }
+
+    pub const unsafe fn CMSG_LEN(length: c_uint) -> c_uint {
+        CMSG_ALIGN(size_of::<crate::cmsghdr>()) as c_uint + length
+    }
+
+    pub unsafe fn FD_CLR(fd: c_int, set: *mut fd_set) -> () {
+        let fd = fd as usize;
+        let size = size_of_val(&(*set).fds_bits[0]) * 8;
+        (*set).fds_bits[fd / size] &= !(1 << (fd % size));
+        return;
+    }
+
+    pub unsafe fn FD_ISSET(fd: c_int, set: *const fd_set) -> bool {
+        let fd = fd as usize;
+        let size = size_of_val(&(*set).fds_bits[0]) * 8;
+        return ((*set).fds_bits[fd / size] & (1 << (fd % size))) != 0;
+    }
+
+    pub unsafe fn FD_SET(fd: c_int, set: *mut fd_set) -> () {
+        let fd = fd as usize;
+        let size = size_of_val(&(*set).fds_bits[0]) * 8;
+        (*set).fds_bits[fd / size] |= 1 << (fd % size);
+        return;
+    }
+
+    pub unsafe fn FD_ZERO(set: *mut fd_set) -> () {
+        (*set).fds_bits.fill(0);
+    }
+
+    pub unsafe fn CPU_ZERO(cpuset: &mut cpu_set_t) -> () {
+        cpuset.bits.fill(0);
+    }
+
+    pub unsafe fn CPU_SET(cpu: usize, cpuset: &mut cpu_set_t) -> () {
+        let size = size_of_val(&cpuset.bits[0]) * 8;
+        cpuset.bits[cpu / size] |= 1 << (cpu % size);
+    }
+
+    pub unsafe fn CPU_CLR(cpu: usize, cpuset: &mut cpu_set_t) -> () {
+        let size = size_of_val(&cpuset.bits[0]) * 8;
+        cpuset.bits[cpu / size] &= !(1 << (cpu % size));
+    }
+
+    pub unsafe fn CPU_ISSET(cpu: usize, cpuset: &cpu_set_t) -> bool {
+        let size = size_of_val(&cpuset.bits[0]) * 8;
+        0 != (cpuset.bits[cpu / size] & (1 << (cpu % size)))
+    }
+
+    pub unsafe fn CPU_COUNT(cpuset: &cpu_set_t) -> c_int {
+        let mut count = 0;
+        let mut i = 0;
+        while i < cpuset.bits.len() {
+            count += cpuset.bits[i].count_ones() as c_int;
+            i += 1;
+        }
+        count
+    }
+}
