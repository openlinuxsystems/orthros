+impl siginfo_t {
+    pub unsafe fn si_addr(&self) -> *mut c_void {
+        #[repr(C)]
+        struct siginfo_sigfault {
+            _si_signo: c_int,
+            _si_errno: c_int,
+            _si_code: c_int,
+            si_addr: *mut c_void,
+        }
+        (*(self as *const siginfo_t).cast::<siginfo_sigfault>()).si_addr
+    }
+
+    pub unsafe fn si_value(&self) -> crate::sigval {
+        #[repr(C)]
+        struct siginfo_si_value {
+            _si_signo: c_int,
+            _si_errno: c_int,
+            _si_code: c_int,
+            _si_timerid: c_int,
+            _si_overrun: c_int,
+            si_value: crate::sigval,
+        }
+        (*(self as *const siginfo_t).cast::<siginfo_si_value>()).si_value
+    }
+
+    unsafe fn sigchld(&self) -> &sifields_sigchld {
+        &(*(self as *const siginfo_t).cast::<siginfo_sigchld>()).sigchld
+    }
+
+    pub unsafe fn si_pid(&self) -> crate::pid_t {
+        self.sigchld().si_pid
+    }
+
+    pub unsafe fn si_uid(&self) -> crate::uid_t {
+        self.sigchld().si_uid
+    }
+
+    pub unsafe fn si_status(&self) -> c_int {
+        self.sigchld().si_status
+    }
+
+    pub unsafe fn si_utime(&self) -> c_long {
+        self.sigchld().si_utime
+    }
+
+    pub unsafe fn si_stime(&self) -> c_long {
+        self.sigchld().si_stime
+    }
+}
+
+s_no_extra_traits! {
+    // For the accessors above: the fields of SIGCHLD's siginfo_t.
+    struct sifields_sigchld {
+        si_pid: crate::pid_t,
+        si_uid: crate::uid_t,
+        si_status: c_int,
+        si_utime: c_long,
+        si_stime: c_long,
+    }
+
+    struct siginfo_sigchld {
+        _siginfo_base: [c_int; 3],
+        _align: [*mut c_void; 0],
+        sigchld: sifields_sigchld,
+    }
+}
