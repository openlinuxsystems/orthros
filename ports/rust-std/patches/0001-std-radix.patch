+#[cfg(target_os = "radix")]
+pub fn current_exe() -> io::Result<PathBuf> {
+    // The path the program was run as, and the working directory then,
+    // which the kernel puts in the auxiliary vector.
+    let path = |kind| {
+        let s = crate::ptr::with_exposed_provenance::<c_char>(unsafe { libc::getauxval(kind) } as usize);
+        (!s.is_null()).then(|| PathBuf::from(OsStr::from_bytes(unsafe { CStr::from_ptr(s) }.to_bytes())))
+    };
+    match path(libc::AT_EXECFN) {
+        Some(exe) if exe.is_absolute() => Ok(exe),
+        Some(exe) => match path(libc::AT_RADIX_CWD) {
+            Some(cwd) => Ok(cwd.join(exe)),
+            None => crate::env::current_dir().map(|cwd| cwd.join(exe)),
+        },
+        None => Err(io::const_error!(io::ErrorKind::Uncategorized, "the program's path is not known")),
+    }
+}
