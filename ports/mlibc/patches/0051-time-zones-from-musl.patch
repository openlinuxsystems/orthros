-// Assumes TZ environment variable rules are used, not TZFILE.
-bool is_in_dst(time_t unix_gmt) {
-	if (rules[0].type == TZFILE)
-	    __ensure(!"is_in_dst() called with invalid rules");
-
-	struct tm now;
