-// Given a rule and a year, compute the time of the transition in seconds since the epoch.
-// TODO: Take into account the time of day when the transition occurs
-// The day `rule` names in `year`, at 00:00 UTC, in seconds since 1970 (its
-// time of day is the caller's to add).
-time_t time_from_rule(const Rule &rule, int year) {
-	using namespace mlibc::musl_time;
-	time_t january1 = year_to_secs(year - 1900, nullptr);
-	if (rule.type == JULIAN_DAY) {
-		// Jn: day n of 1 to 365, never counting 29 February.
-		int day = rule.day - 1;
-		if (is_leap_year(year) && rule.day >= 60)
-			day++;
-		return january1 + day * 86400LL;
-	} else if (rule.type == DAY_OF_YEAR) {
-		// n: day n of 0 to 365, counting 29 February.
-		return january1 + rule.day * 86400LL;
-	} else if (rule.type == MONTH_NTH_DAY_OF_WEEK) {
-		// Mm.n.d: weekday d (0 is Sunday) of week n (5 is the last) of
-		// month m.
-		struct tm t = {};
-		t.tm_year = year - 1900;
-		t.tm_mon = rule.month - 1;
-		t.tm_mday = 1;
-		time_t first = tm_to_secs(&t);
-		t.tm_mon++;
-		int days_in_month = (tm_to_secs(&t) - first) / 86400;
-		struct tm f;
-		secs_to_tm(first, &f);
-		int day = 1 + ((7 + rule.day - f.tm_wday) % 7) + (rule.week - 1) * 7;
-		while (day > days_in_month)
-			day -= 7;
-		return first + (day - 1) * 86400LL;
-	} else {
-		__ensure(!"Invalid rule type");
-		__builtin_unreachable();
-	}
-}
