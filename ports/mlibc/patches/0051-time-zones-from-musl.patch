-	// The transitions of the year: a rule's time is local, in standard
-	// time for the start and in daylight time for the end (POSIX).
-	time_t start_time = time_from_rule(rules[0], year) + rules[0].time + timezone;
-	time_t end_time = time_from_rule(rules[1], year) + rules[1].time
