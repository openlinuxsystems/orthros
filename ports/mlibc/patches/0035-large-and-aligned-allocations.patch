-	__ensure(!"Not implemented");
-	__builtin_unreachable();
+void *memalign(size_t alignment, size_t size) {
+	// As glibc's: an alignment that is not a power of two is rounded up to
+	// one, and one past the largest power of two fails with EINVAL.
+	if(alignment > SIZE_MAX / 2 + 1) {
+		errno = EINVAL;
+		return nullptr;
+	}
+	size_t power = sizeof(void *);
+	while(power < alignment)
+		power <<= 1;
+	void *p;
+	if(int e = posix_memalign(&p, power, size); e) {
+		errno = e;
+		return nullptr;
+	}
+	return p;
 }
