+template<typename Policy, typename Mutex>
+void *slab_pool<Policy, Mutex>::allocate_aligned(size_t length, size_t align) {
+	FRG_ASSERT(align && !(align & (align - 1)));
+	// A small block lies at a multiple of its bucket's size, and a large
+	// one at a multiple of the page size.
+	if(!length)
+		length = 1;
+	if(align <= page_size || frg::max(length, align) <= policy_traits::max_bucket_size)
+		return allocate(frg::max(length, align));
+	// The mapping holds the block, its padding and the alignment's slack.
+	if(align > max_length || length > max_length - align)
+		return nullptr;
+	return _allocate_large(length, align);
+}
