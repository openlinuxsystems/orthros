diff -ruN a/options/internal/generic/stdlib.cpp b/options/internal/generic/stdlib.cpp
--- a/options/internal/generic/stdlib.cpp
+++ b/options/internal/generic/stdlib.cpp
@@ -9,33 +9,49 @@
 
 namespace mlibc {
 
+int random_name(char *x) {
+	static const char letters[] =
+		"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789";
+	unsigned char bytes[6];
+	if(int e = mlibc::sysdep_or_enosys<GetEntropy>(bytes, sizeof(bytes)); e)
+		return e;
+	// 62 does not divide 256, so the first letters come up a little more
+	// often (by 4 in 256): no matter for a name that only has to be new.
+	for(size_t i = 0; i < 6; i++)
+		x[i] = letters[bytes[i] % 62];
+	return 0;
+}
+
+// Names chosen at random rather than in turn, as glibc's and musl's are,
+// so that the next one cannot be guessed and taken first.
 int mkostemps(char *pattern, int suffixlen, int flags, int *fd) {
 	auto n = strlen(pattern);
-	if(n < (6 + static_cast<size_t>(suffixlen))) {
+	if(suffixlen < 0 || n < (6 + static_cast<size_t>(suffixlen))) {
 		return EINVAL;
 	}
 
 	flags &= ~O_WRONLY;
 
+	char *x = pattern + (n - (6 + suffixlen));
 	for(size_t i = 0; i < 6; i++) {
-		if(pattern[n - (6 + suffixlen) + i] == 'X')
+		if(x[i] == 'X')
 			continue;
 		return EINVAL;
 	}
 
-	// TODO: Do an exponential search.
-	for(size_t i = 0; i < 999999; i++) {
-		char sfx = pattern[n - suffixlen];
-		__ensure(sprintf(pattern + (n - (6 + suffixlen)), "%06zu", i) == 6);
-		pattern[n - suffixlen] = sfx;
+	for(int i = 0; i < TEMP_TRIES; i++) {
+		if(int e = random_name(x); e)
+			return e;
 
 		if(int e = mlibc::sysdep<Open>(pattern, O_RDWR | O_CREAT | O_EXCL | flags, S_IRUSR | S_IWUSR, fd); !e) {
 			return 0;
 		}else if(e != EEXIST) {
+			memset(x, 'X', 6);
 			return e;
 		}
 	}
 
+	memset(x, 'X', 6);
 	return EEXIST;
 }
 
diff -ruN a/options/internal/include/mlibc/stdlib.hpp b/options/internal/include/mlibc/stdlib.hpp
--- a/options/internal/include/mlibc/stdlib.hpp
+++ b/options/internal/include/mlibc/stdlib.hpp
@@ -2,6 +2,14 @@
 
 namespace mlibc {
 
+// How many names mkostemps, mkdtemp, mktemp and tmpnam try before they
+// give up: with 62^6 names, a clash at all is unlikely.
+inline constexpr int TEMP_TRIES = 100;
+
+// Fills `x`, 6 characters, with letters and digits chosen at random
+// (getentropy), as a temporary file's name; returns an errno value.
+int random_name(char *x);
+
 int mkostemps(char *pattern, int suffixlen, int flags, int *fd);
 
 } // namespace mlibc
