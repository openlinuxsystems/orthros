-char *mktemp(char *) {
-	__ensure(!"Not implemented");
-	__builtin_unreachable();
+// A name no file has yet, chosen at random as mkstemp's are; but another
+// may take it before the caller does, so mkstemp is the one to use.
+char *mktemp(char *pattern) {
+	auto n = strlen(pattern);
+	char *x = pattern + (n < 6 ? 0 : n - 6);
+	if(n < 6 || memcmp(x, "XXXXXX", 6)) {
+		errno = EINVAL;
+		pattern[0] = 0;
+		return pattern;
+	}
+	for(int i = 0; i < mlibc::TEMP_TRIES; i++) {
+		if(int e = mlibc::random_name(x); e) {
+			errno = e;
+			pattern[0] = 0;
+			return pattern;
+		}
+		struct stat st;
+		int e = mlibc::sysdep_or_enosys<Stat>(mlibc::fsfd_target::path, -1, pattern,
+				AT_SYMLINK_NOFOLLOW, &st);
+		if(e == ENOENT)
+			return pattern;
+		if(e) {
+			errno = e;
+			pattern[0] = 0;
+			return pattern;
+		}
+	}
+	errno = EEXIST;
+	pattern[0] = 0;
+	return pattern;
 }
 
