+
+// The environment that putenv() and setenv() add to is an array of our
+// own with room to grow; one a program points environ at is copied
+// into a new one first. Running out of memory fails the change and
+// leaves the environment as it was, as in musl.
+constinit char **owned_environ = nullptr;
+constinit size_t owned_room = 0;
+
+// Makes environ our own array, with room for one more string.
+bool own_environ() {
+	size_t size = environ_size();
+	if(environ == owned_environ && size + 2 <= owned_room)
+		return true;
+
+	size_t room = 2 * (size + 2);
+	auto array = static_cast<char **>(malloc(room * sizeof(char *)));
+	if(!array)
+		return false;
+	memcpy(array, environ, (size + 1) * sizeof(char *));
+	free(owned_environ);
+	owned_environ = array;
+	owned_room = room;
+	environ = array;
+	return true;
