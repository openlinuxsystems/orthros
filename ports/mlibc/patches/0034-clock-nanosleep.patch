+int clock_nanosleep(clockid_t clockid, int flags, const struct timespec *req, struct timespec *rem) {
+	// clock_nanosleep returns the error number and leaves errno alone.
+	// The clocks are Linux's, and so are the answers: those that drive no
+	// timers are not supported, a thread's CPU time and unknown clocks are
+	// invalid.
+	switch(clockid) {
+	case CLOCK_REALTIME:
+	case CLOCK_MONOTONIC:
+	case CLOCK_BOOTTIME:
+	case CLOCK_TAI:
+	case CLOCK_PROCESS_CPUTIME_ID:
+		break;
+	case CLOCK_MONOTONIC_RAW:
+	case CLOCK_REALTIME_COARSE:
+	case CLOCK_MONOTONIC_COARSE:
+	case CLOCK_REALTIME_ALARM:
+	case CLOCK_BOOTTIME_ALARM:
+		return ENOTSUP;
+	default:
+		return EINVAL;
 	}
+	if(req->tv_sec < 0 || req->tv_nsec < 0 || req->tv_nsec > 999999999)
+		return EINVAL;
 
-	return nanosleep(req, rem);
+	struct timespec now;
+	if(int e = mlibc::sysdep<ClockGet>(clockid, &now.tv_sec, &now.tv_nsec); e)
+		return e;
+	// The time on the clock to wake at. A relative time past the clock's
+	// last is a sleep without end.
+	struct timespec end = *req;
+	if(!(flags & TIMER_ABSTIME)) {
+		constexpr time_t last = static_cast<time_t>(~0ULL >> 1);
+		if(req->tv_sec >= last - now.tv_sec) {
+			end = {last, 999999999};
+		} else {
+			end.tv_sec = now.tv_sec + req->tv_sec;
+			end.tv_nsec = now.tv_nsec + req->tv_nsec;
+			if(end.tv_nsec > 999999999) {
+				end.tv_sec++;
+				end.tv_nsec -= 1000000000;
+			}
+		}
+	}
+	// The process's CPU time grows at most as fast as every CPU together,
+	// so a sleep on it waits the share of what is left that cannot be too
+	// long, and looks again; the other clocks run with the time the sleep
+	// waits on, and are looked at again only in case they ran slower.
+	long cpus = 1;
+	if(clockid == CLOCK_PROCESS_CPUTIME_ID) {
+		long online = sysconf(_SC_NPROCESSORS_ONLN);
+		if(online > 1)
+			cpus = online;
+	}
+	while(timespec_before(now, end)) {
+		struct timespec left = timespec_minus(end, now);
+		struct timespec wait = {left.tv_sec / cpus,
+				((left.tv_sec % cpus) * 1000000000 + left.tv_nsec) / cpus};
+		if(int e = mlibc::sysdep_or_enosys<Sleep>(&wait.tv_sec, &wait.tv_nsec); e) {
+			// An interrupted relative sleep tells what was left of it.
+			if(e == EINTR && rem && !(flags & TIMER_ABSTIME)) {
+				*rem = {0, 0};
+				if(!mlibc::sysdep<ClockGet>(clockid, &now.tv_sec, &now.tv_nsec)
+						&& timespec_before(now, end))
+					*rem = timespec_minus(end, now);
+			}
+			return e;
+		}
+		if(int e = mlibc::sysdep<ClockGet>(clockid, &now.tv_sec, &now.tv_nsec); e)
+			return e;
+	}
+	return 0;
 }
 
