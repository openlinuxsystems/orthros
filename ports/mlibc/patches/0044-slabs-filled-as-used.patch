 	slab_frame *_construct_slab(int index);
 
+	// Whether the slab has an object left: a freed one or a fresh one.
+	static bool has_room_(slab_frame *slb) {
+		size_t item_size = policy_traits::bucket_to_size(slb->index);
+		return slb->available || slb->address + slb->length - slb->fresh >= item_size;
+	}
+
+	// Takes an object out of a slab with room: a freed one first, which
+	// is likelier to be in the cache, else the next fresh one.
+	freelist *take_from_slab_(slab_frame *slb) {
+		freelist *object = slb->available;
+		if(object) {
+			FRG_ASSERT(slb->contains(object));
+			if(object->link && !slb->contains(object->link))
+				FRG_ASSERT(!"slab_pool corruption. Possible write to unallocated object");
+			slb->available = object->link;
+		}else{
+			FRG_ASSERT(has_room_(slb));
+			if constexpr (slab::has_poisoning_support<Policy>)
+				_plcy.unpoison(reinterpret_cast<void *>(slb->fresh), sizeof(freelist));
+			object = new (reinterpret_cast<void *>(slb->fresh)) freelist;
+			slb->fresh += policy_traits::bucket_to_size(slb->index);
+		}
+		slb->num_reserved++;
+		return object;
+	}
