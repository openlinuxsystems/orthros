Running out of memory is an error, not a crash or a quiet success, as
libc-test's regression/malloc-oom, setenv-oom and pthread_create-oom
check: the allocator gives back no memory when the system has none
(it went on with a null slab), malloc and realloc set ENOMEM when they
fail, and a thread's TLS block that cannot be allocated fails
pthread_create (in threads.cpp, 0019) where it used to crash. Meant for
upstream.

diff -ruN a/options/ansi/generic/stdlib.cpp b/options/ansi/generic/stdlib.cpp
--- a/options/ansi/generic/stdlib.cpp
+++ b/options/ansi/generic/stdlib.cpp
@@ -600,6 +600,8 @@
 
 void *malloc(size_t size) {
 	auto nptr = getAllocator().allocate(size);
+	if(!nptr)
+		errno = ENOMEM;
 	// TODO: Print PID only if POSIX option is enabled.
 	if (mlibc::globalConfig().debugMalloc)
 		mlibc::infoLogger() << "mlibc (PID ?): malloc() returns "
@@ -609,6 +611,10 @@
 
 void *realloc(void *ptr, size_t size) {
 	auto nptr = getAllocator().reallocate(ptr, size);
+	// realloc(ptr, 0) frees ptr and returns a null pointer; any other
+	// null pointer means memory ran out.
+	if(!nptr && size)
+		errno = ENOMEM;
 	// TODO: Print PID only if POSIX option is enabled.
 	if (mlibc::globalConfig().debugMalloc)
 		mlibc::infoLogger() << "mlibc (PID ?): realloc() on "
diff -ruN a/options/internal/generic/allocator.cpp b/options/internal/generic/allocator.cpp
--- a/options/internal/generic/allocator.cpp
+++ b/options/internal/generic/allocator.cpp
@@ -33,8 +33,10 @@
 // --------------------------------------------------------
 
 uintptr_t VirtualAllocator::map(size_t length) {
+	// Out of memory is 0, which the slab pool passes on as a null pointer.
 	void *ptr;
-	__ensure(!mlibc::sysdep<AnonAllocate>(length, &ptr));
+	if(mlibc::sysdep<AnonAllocate>(length, &ptr))
+		return 0;
 	return (uintptr_t)ptr;
 }
 
