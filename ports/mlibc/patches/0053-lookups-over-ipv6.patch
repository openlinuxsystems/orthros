+// Orders addresses as RFC 6724's destination address selection does, as
+// glibc and musl do, when IPv6 ones are among them: those the machine has
+// a route to first, then those whose scope and label match those of the
+// address it would send from, of higher precedence, of smaller scope, and
+// sharing more of its prefix with the source, else in the order found.
+// Whether an address is deprecated is not known here, nor are the other
+// rules, which are for mobile IPv6 and transition mechanisms.
+void sort_addresses(struct lookup_result &buf) {
+	constexpr size_t MOST = 64;
+	size_t count = buf.buf.size();
+	if (count < 2 || count > MOST)
+		return;
+	bool ipv6 = false;
+	for (auto &address : buf.buf)
+		ipv6 |= address.family == AF_INET6;
+	if (!ipv6)
+		return;
+
+	// Each address's key: the larger sorts first.
+	uint32_t keys[MOST];
+	size_t order[MOST];
+	for (size_t i = 0; i < count; i++) {
+		uint8_t to[16], from[16];
+		as_ipv6(buf.buf[i], to);
+		const policy &to_policy = policy_of(to);
+		int to_scope = scope_of(to);
+		uint32_t key = 0;
+		if (source_for(buf.buf[i], from)) {
+			int from_scope = scope_of(from);
+			key |= 1u << 30;
+			if (from_scope == to_scope)
+				key |= 1u << 29;
+			if (policy_of(from).label == to_policy.label)
+				key |= 1u << 28;
+			// RFC 6724 6, rule 9, for IPv6 alone, within the source's
+			// network, taken as a /64.
+			if (buf.buf[i].family == AF_INET6)
+				key |= common_bits(from, to, 64);
+		}
+		key |= static_cast<uint32_t>(to_policy.precedence) << 20;
+		key |= static_cast<uint32_t>(15 - to_scope) << 16;
+		keys[i] = key;
+		order[i] = i;
+	}
+	// A stable insertion sort, for the few there are.
+	for (size_t i = 1; i < count; i++) {
+		size_t at = order[i];
+		size_t j = i;
+		for (; j && keys[order[j - 1]] < keys[at]; j--)
+			order[j] = order[j - 1];
+		order[j] = at;
+	}
+	frg::vector<struct dns_addr_buf, MemoryAllocator> sorted{getAllocator()};
+	for (size_t i = 0; i < count; i++)
+		sorted.push(std::move(buf.buf[order[i]]));
+	buf.buf = std::move(sorted);
+}
