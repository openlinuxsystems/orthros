+	// An address as IPv6: an IPv4 one mapped.
+	void as_ipv6(const struct dns_addr_buf &address, uint8_t *out) {
+		if (address.family == AF_INET6) {
+			memcpy(out, address.addr, 16);
+			return;
+		}
+		memset(out, 0, 10);
+		out[10] = out[11] = 0xff;
+		memcpy(out + 12, address.addr, 4);
+	}
