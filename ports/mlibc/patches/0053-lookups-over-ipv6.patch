+		memset(&to, 0, sizeof(to));
+		socklen_t size;
+		if (address.family == AF_INET6) {
+			to.in6.sin6_family = AF_INET6;
+			to.in6.sin6_port = htons(65535);
+			memcpy(&to.in6.sin6_addr, address.addr, 16);
+			size = sizeof(to.in6);
+		} else {
+			to.in.sin_family = AF_INET;
+			to.in.sin_port = htons(65535);
+			memcpy(&to.in.sin_addr, address.addr, 4);
+			size = sizeof(to.in);
+		}
+		int fd = socket(address.family, SOCK_DGRAM | SOCK_CLOEXEC, IPPROTO_UDP);
+		if (fd < 0)
+			return false;
+		socklen_t from_size = sizeof(from);
+		bool found = !connect(fd, &to.sa, size) && !getsockname(fd, &from.sa, &from_size);
+		close(fd);
+		if (!found)
