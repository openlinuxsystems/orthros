+	bool parse_server(const string &text, server &out) {
+		memset(&out, 0, sizeof(out));
+		if (inet_pton(AF_INET, text.data(), &out.address.in.sin_addr) == 1) {
+			out.address.in.sin_family = AF_INET;
+			out.address.in.sin_port = htons(DNS_PORT);
+			out.size = sizeof(out.address.in);
+			return true;
+		}
+		char ip[INET6_ADDRSTRLEN];
+		auto percent = static_cast<const char *>(memchr(text.data(), '%', text.size()));
+		size_t length = percent ? percent - text.data() : text.size();
+		if (length >= sizeof(ip))
