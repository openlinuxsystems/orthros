+		source.family = from.sa.sa_family;
+		if (source.family == AF_INET6)
+			memcpy(source.addr, &from.in6.sin6_addr, 16);
+		else
+			memcpy(source.addr, &from.in.sin_addr, 4);
+		as_ipv6(source, out);
+		return true;
+	}
