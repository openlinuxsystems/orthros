+// The fields of `tm` may be out of range (a 32nd of January is the 1st
+// of February); tm_wday and tm_yday are ignored and set, and the others
+// put in range, as musl does.
+time_t mktime(struct tm *tm) {
+	long long local = mlibc::musl_time::tm_to_secs(tm);
+	time_t offset = 0;
+	bool dst;
+	char *tm_zone;
+	frg::unique_lock<FutexLock> lock(__time_lock);
+	// The offset in force at that local time: the one at `local` read as
+	// UTC is near enough to find it on a second look.
+	zone_at(local, &offset, &dst, &tm_zone);
+	zone_at(local - offset, &offset, &dst, &tm_zone);
+	long long t = local - offset;
+	struct tm result;
+	if (t != static_cast<time_t>(t) || mlibc::musl_time::secs_to_tm(t + offset, &result)) {
+		errno = EOVERFLOW;
+		return -1;
+	}
+	result.tm_isdst = dst;
+	result.tm_zone = tm_zone;
+	result.tm_gmtoff = offset;
+	*tm = result;
+	return t;
+}
