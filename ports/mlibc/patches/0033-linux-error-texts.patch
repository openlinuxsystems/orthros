+
+// The text for `e`, or null if it is no error number.
+const char *error_text(int e) {
+	if(e < 0 || static_cast<size_t>(e) >= sizeof(error_texts) / sizeof(*error_texts))
+		return nullptr;
+	return error_texts[e];
+}
+
+// "Unknown error N", as glibc words a number it does not know, cut to
+// fit `size` bytes with its NUL.
+void unknown_error(int e, char *buffer, size_t size) {
+	if(!size)
+		return;
+	char digits[16];
+	size_t n = 0;
+	unsigned int magnitude = e < 0 ? 0u - static_cast<unsigned int>(e) : static_cast<unsigned int>(e);
+	do {
+		digits[n++] = static_cast<char>('0' + magnitude % 10);
+		magnitude /= 10;
+	} while(magnitude);
+	if(e < 0)
+		digits[n++] = '-';
+	size_t at = mlibc::strlcpy(buffer, "Unknown error ", size);
+	if(at >= size)
+		return;
+	while(n && at + 1 < size)
+		buffer[at++] = digits[--n];
+	buffer[at] = '\0';
+}
+
+} // namespace
+
+char *strerror(int e) {
+	if(auto s = error_text(e))
+		return const_cast<char *>(s);
+	static thread_local char unknown[32];
+	unknown_error(e, unknown, sizeof(unknown));
+	return unknown;
 }
