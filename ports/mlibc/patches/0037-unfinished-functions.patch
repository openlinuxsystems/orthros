+// BSD's: the next line with its newline, or what is left before the end
+// of the file, valid until the next read. It is kept in the calling
+// thread's buffer, so reading another stream with fgetln ends it too.
+char *fgetln(FILE *stream, size_t *size) {
+	static thread_local char *line;
+	static thread_local size_t room;
+	ssize_t n = getline(&line, &room, stream);
+	if(n <= 0)
+		return nullptr;
+	*size = n;
+	return line;
 }
 
