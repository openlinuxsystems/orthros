+// The bytes the name at `p` takes there, or -1 if it runs past `eom`.
+int skip_name(const unsigned char *p, const unsigned char *eom) {
+	const unsigned char *start = p;
+	while(p < eom) {
+		unsigned c = *p;
+		if(!c)
+			return p + 1 - start;
+		if((c & NS_CMPRSFLGS) == NS_CMPRSFLGS)
+			return eom - p < 2 ? -1 : p + 2 - start;
+		if(c & NS_CMPRSFLGS || eom - p <= c)
+			return -1;
+		p += c + 1;
+	}
+	return -1;
