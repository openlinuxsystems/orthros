+// Writes the dotted name `name` as a DNS name at `out`, in at most
+// `length` bytes, with glibc's escapes (\. and \DDD). The labels are
+// written whole: pointers to names earlier in the message are optional
+// in DNS, so `dnptrs` is neither searched nor added to.
+int dn_comp(const char *name, unsigned char *out, int length, unsigned char **, unsigned char **) {
+	int at = 0;
+	const char *p = name;
+	// "." alone is the root.
+	if(p[0] == '.' && !p[1])
+		p++;
+	while(*p) {
+		int start = at++;
+		int label = 0;
+		for(; *p && *p != '.'; label++) {
+			unsigned c = static_cast<unsigned char>(*p++);
+			if(c == '\\') {
+				if(p[0] >= '0' && p[0] <= '9' && p[1] >= '0' && p[1] <= '9'
+						&& p[2] >= '0' && p[2] <= '9') {
+					c = (p[0] - '0') * 100 + (p[1] - '0') * 10 + (p[2] - '0');
+					p += 3;
+				}else if(*p) {
+					c = static_cast<unsigned char>(*p++);
+				}else{
+					goto bad;
+				}
+				if(c > 255)
+					goto bad;
+			}
+			if(label == NS_MAXLABEL || at >= length || at >= NS_MAXCDNAME - 1)
+				goto bad;
+			out[at++] = c;
+		}
+		// Only the root's label is empty, and it is the last.
+		if(!label)
+			goto bad;
+		out[start] = label;
+		if(*p == '.')
+			p++;
+	}
+	if(at >= length)
+		goto bad;
+	out[at++] = 0;
+	return at;
+bad:
+	errno = EMSGSIZE;
+	return -1;
 }
 
