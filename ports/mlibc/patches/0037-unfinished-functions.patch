+// As glibc's: in $TMPDIR (unless the program runs set-user-ID), else
+// `dir`, else P_tmpdir, else /tmp, whichever is a directory; the first
+// five bytes of `pfx`, "file" without one, and six random letters.
+char *tempnam(const char *dir, const char *pfx) {
+	const char *base = secure_getenv("TMPDIR");
+	if(!is_directory(base))
+		base = dir;
+	if(!is_directory(base))
+		base = P_tmpdir;
+	if(!is_directory(base))
+		base = "/tmp";
+	if(!is_directory(base)) {
+		errno = ENOENT;
+		return nullptr;
+	}
+	size_t length = strlen(base);
+	while(length > 1 && base[length - 1] == '/')
+		length--;
+	if(!pfx || !*pfx)
+		pfx = "file";
+	size_t room = length + 1 + 5 + 6 + 1;
+	auto name = static_cast<char *>(malloc(room));
+	if(!name) {
+		errno = ENOMEM;
+		return nullptr;
+	}
+	for(int i = 0; i < mlibc::TEMP_TRIES; i++) {
+		char x[6];
+		if(mlibc::random_name(x))
+			break;
+		snprintf(name, room, "%.*s/%.5s%.6s", static_cast<int>(length), base, pfx, x);
+		struct stat st;
+		if(lstat(name, &st) && errno == ENOENT)
+			return name;
+	}
+	free(name);
+	errno = EEXIST;
+	return nullptr;
 }
 
