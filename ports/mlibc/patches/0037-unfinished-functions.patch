+// The clock is read but never set, so this is what Linux tells a program
+// that may not set it, about a clock no time server has synchronized:
+// TIME_ERROR, STA_UNSYNC, the largest errors, a tick of 10 ms.
+int adjtimex(struct timex *buf) {
+	if(buf->modes) {
+		errno = EPERM;
+		return -1;
+	}
+	struct timespec now;
+	clock_gettime(CLOCK_REALTIME, &now);
+	memset(buf, 0, sizeof(*buf));
+	buf->maxerror = 16000000;
+	buf->esterror = 16000000;
+	buf->status = STA_UNSYNC;
+	buf->constant = 2;
+	buf->precision = 1;
+	buf->tolerance = 32768000;
+	buf->time.tv_sec = now.tv_sec;
+	buf->time.tv_usec = now.tv_nsec / 1000;
+	buf->tick = 10000;
+	return TIME_ERROR;
 }
 
