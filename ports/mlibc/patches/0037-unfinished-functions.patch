-	__ensure(!"Not implemented");
-	__builtin_unreachable();
+// Linux's answers: the realtime clock is adjtimex's, the other clocks
+// cannot be adjusted, and an unknown one is invalid.
+int clock_adjtime(clockid_t clock, struct timex *buf) {
+	if(clock == CLOCK_REALTIME)
+		return adjtimex(buf);
+	errno = clock >= 0 && clock <= CLOCK_TAI && clock != 10 ? EOPNOTSUPP : EINVAL;
+	return -1;
