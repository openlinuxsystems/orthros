+}
+
+void fork_finish(void *last, bool child) {
+	// A thread the child does not have may have held the lock.
+	if (child)
+		new (&atfork_lock) FutexLock{};
+	if (!last)
+		return;
+	for (auto hand = atfork_first; ; hand = hand->next) {
+		auto handler = child ? hand->child : hand->parent;
+		if (handler)
+			handler();
+		if (hand == last)
+			break;
+	}
