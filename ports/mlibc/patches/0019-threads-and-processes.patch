+	frg::unique_lock lock(atfork_lock);
+	hand->prev = atfork_last;
+	if (atfork_last)
+		atfork_last->next = hand;
+	else
+		atfork_first = hand;
+	__atomic_store_n(&atfork_last, hand, __ATOMIC_RELEASE);
 
