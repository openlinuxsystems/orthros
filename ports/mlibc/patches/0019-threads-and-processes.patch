+	constinit FutexLock atfork_lock{};
+	constinit Tcb::AtforkHandler *atfork_first = nullptr;
+	constinit Tcb::AtforkHandler *atfork_last = nullptr;
+} // namespace
 
+int pthread_atfork(void (*prepare) (void), void (*parent) (void), void (*child) (void)) {
 	auto hand = frg::construct<Tcb::AtforkHandler>(getAllocator());
