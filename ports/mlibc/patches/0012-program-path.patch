Programs are in /system/bin on Dukovo, which has no /bin or /usr:
execvp and its kin search /system/bin when PATH is not set, and
confstr(_CS_PATH) names it. confstr fails with EINVAL for a name it does
not know, as POSIX says, instead of ending the program.

diff -ruN a/options/posix/generic/unistd.cpp b/options/posix/generic/unistd.cpp
--- a/options/posix/generic/unistd.cpp
+++ b/options/posix/generic/unistd.cpp
@@ -65,7 +65,8 @@
 size_t confstr(int name, char *buf, size_t len) {
 	const char *str = "";
 	if (name == _CS_PATH) {
-		str = "/bin:/usr/bin";
+		// Dukovo's programs are in /system/bin; there is no /bin or /usr.
+		str = "/system/bin";
 	} else if(name == _CS_GNU_LIBPTHREAD_VERSION) {
 		// We are not glibc, so we can return 0 here.
 		return 0;
@@ -73,9 +74,9 @@
 		// We are not glibc, so we can return 0 here.
 		return 0;
 	} else {
-		mlibc::infoLogger() << "\e[31mmlibc: confstr() request " << name << " is unimplemented\e[39m"
-				<< frg::endlog;
-		__ensure(!"Not implemented");
+		// A name it does not know, as POSIX says.
+		errno = EINVAL;
+		return 0;
 	}
 
 	return snprintf(buf, len, "%s", str) + 1;
@@ -177,7 +178,7 @@
 	if(const char *pv = getenv("PATH"); pv) {
 		dirs = pv;
 	}else{
-		dirs = "/bin:/usr/bin";
+		dirs = "/system/bin";
 	}
 
 	size_t p = 0;
