getpriority returns -1 when it fails, as POSIX says, rather than 0: a
caller tells a failure from a nice level of -1 by errno, which it sets
to 0 first.

diff -ruN a/options/posix/generic/sys-resource.cpp b/options/posix/generic/sys-resource.cpp
--- a/options/posix/generic/sys-resource.cpp
+++ b/options/posix/generic/sys-resource.cpp
@@ -11,6 +11,7 @@
 	int value = 0;
 	if(int e = mlibc::sysdep_or_enosys<GetPriority>(which, who, &value); e) {
 		errno = e;
+		return -1;
 	}
 	return value;
 }
