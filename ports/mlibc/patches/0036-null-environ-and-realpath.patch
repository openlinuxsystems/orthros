-	for(size_t i = 0; environ[i]; i++) {
+	for(size_t i = 0; environ && environ[i]; i++) {
 		frg::string_view view{environ[i]};
 		size_t s = view.find_first('=');
-		if(s == size_t(-1)) {
-			mlibc::infoLogger() << "mlibc: environment string \""
