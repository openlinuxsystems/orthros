A new thread's signal mask (after patch 0038). pthread_create logged and
ignored a mask set with pthread_attr_setsigmask_np, and a thread made by
one whose cancellation was disabled, which blocks SIGCANCEL, started with
SIGCANCEL blocked though its own cancellation was enabled, so a cancel
could not end a wait it was in. Now such a thread starts with every
signal blocked and takes its mask, the attributes' with the C library's
own signals as its creator has them, and never SIGCANCEL, before its
function runs, as glibc's and musl's threads do; other threads start as
before. An affinity in the attributes, which Radix cannot honour yet, is
logged once rather than on every create. Meant for upstream.

--- a/options/internal/generic/threads.cpp
+++ b/options/internal/generic/threads.cpp
@@ -7,10 +7,13 @@
 #include <mlibc/allocator.hpp>
 #include <mlibc/debug.hpp>
 #include <mlibc/lock.hpp>
+#include <mlibc/sigset.hpp>
 #include <mlibc/threads.hpp>
 #include <mlibc/tcb.hpp>
 #include <mlibc/time-helpers.hpp>
+#include <signal.h>
 #include <stdlib.h>
+#include <string.h>
 
 extern "C" Tcb *__rtld_allocateTcb();
 
@@ -34,6 +37,35 @@
 // exits, the process exits with 0, as POSIX says.
 constinit unsigned int live_threads = 1;
 
+// What a thread whose signal mask is not its creator's starts with: its
+// function and argument, and its mask.
+struct masked_start {
+	void *entry;
+	void *user_arg;
+	sigset_t mask;
+};
+
+int thread_mask(int how, const sigset_t *set, sigset_t *old) {
+	if constexpr (mlibc::IsImplemented<ThreadSigmask>)
+		return mlibc::sysdep<ThreadSigmask>(how, set, old);
+	else
+		return mlibc::sysdep_or_enosys<Sigprocmask>(how, set, old);
+}
+
+// The function such a thread runs first: its creator started it with
+// every signal blocked, so that none reaches it before it takes its own
+// mask.
+template<typename R>
+R start_masked(void *argument) {
+	auto start = static_cast<masked_start *>(argument);
+	auto entry = reinterpret_cast<R (*)(void *)>(start->entry);
+	void *user_arg = start->user_arg;
+	sigset_t mask = start->mask;
+	frg::destruct(getAllocator(), start);
+	thread_mask(SIG_SETMASK, &mask, nullptr);
+	return entry(user_arg);
+}
+
 } // namespace
 
