 char *realpath(const char *path, char *out) {
 	if(mlibc::globalConfig().debugPathResolution)
 		mlibc::infoLogger() << "mlibc realpath(): Called on '" << path << "'" << frg::endlog;
+
+	// A system that resolves paths whole, links and all, says where one
+	// leads in a single call.
+	if constexpr (mlibc::IsImplemented<Realpath>) {
+		char resolved[PATH_MAX];
+		if(int e = mlibc::sysdep<Realpath>(path, resolved, PATH_MAX); e) {
+			errno = e;
+			return nullptr;
+		}
+		if(!out)
+			out = reinterpret_cast<char *>(getAllocator().allocate(strlen(resolved) + 1));
+		strcpy(out, resolved);
+		return out;
+	}
 	frg::string_view path_view{path};
 
