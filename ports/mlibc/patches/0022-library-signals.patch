+++ b/options/internal/include/mlibc/sigset.hpp
@@ -0,0 +1,11 @@
+#pragma once
+
+#include <signal.h>
+
+namespace mlibc {
+
+// sigaddset() for the C library's own use: it also takes the signals
+// from 32 up to SIGRTMIN (SIGCANCEL, SIGTIMER), which programs cannot add.
+int sigaddset_internal(sigset_t *sigset, int sig);
+
+} // namespace mlibc
