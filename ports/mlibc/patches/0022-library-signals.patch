+// raise() signals the calling thread, as C and POSIX say, not the whole
+// process, where another thread could take the signal. Signals stay
+// blocked from finding the thread to sending, as in musl, so that a
+// handler that forks cannot leave the child signalling its parent; the
+// signal arrives as the mask comes back, before raise() returns.
 int raise(int sig) {
+	if constexpr (mlibc::IsImplemented<Tgkill> && mlibc::IsImplemented<Sigprocmask>
+			&& mlibc::IsImplemented<GetPid>) {
+		sigset_t all, old;
+		sigfillset(&all);
+		if (int e = mlibc::sysdep<Sigprocmask>(SIG_BLOCK, &all, &old)) {
+			errno = e;
+			return -1;
+		}
+		int e = mlibc::sysdep<Tgkill>(mlibc::sysdep<GetPid>(), mlibc::this_tid(), sig);
+		mlibc::sysdep<Sigprocmask>(SIG_SETMASK, &old, nullptr);
+		if (e) {
+			errno = e;
+			return -1;
+		}
+		return 0;
+	}
+
 	MLIBC_CHECK_OR_ENOSYS(mlibc::IsImplemented<GetPid> && mlibc::IsImplemented<Kill>, -1);
 	pid_t pid = mlibc::sysdep_or_panic<GetPid>();
 
@@ -32,11 +55,16 @@
