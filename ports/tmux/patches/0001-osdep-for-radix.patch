+#include <sys/types.h>
+
+#include <event.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+#include "tmux.h"
+
+/*
+ * Radix, the kernel of Dukovo, shows each process's program as the name
+ * line of /processes/<number>/status. It keeps no working directory for a
+ * process: that is the C library's.
+ */
+
+char *
+osdep_get_name(int fd, __unused char *tty)
+{
+	FILE	*f;
+	char	*path, line[256], *name = NULL;
+	pid_t	 pgrp;
+	size_t	 len;
+
+	if ((pgrp = tcgetpgrp(fd)) == -1)
+		return (NULL);
+
+	xasprintf(&path, "/processes/%lld/status", (long long) pgrp);
+	f = fopen(path, "r");
+	free(path);
+	if (f == NULL)
+		return (NULL);
+
+	while (fgets(line, sizeof line, f) != NULL) {
+		if (strncmp(line, "name:", 5) != 0)
+			continue;
+		path = line + 5;
+		path += strspn(path, " \t");
+		len = strcspn(path, "\n");
+		if (len != 0)
+			name = xstrndup(path, len);
+		break;
+	}
+	fclose(f);
+	return (name);
+}
+
+char *
+osdep_get_cwd(__unused int fd)
+{
+	return (NULL);
+}
+
+struct event_base *
+osdep_event_init(void)
+{
+	return (event_init());
+}
