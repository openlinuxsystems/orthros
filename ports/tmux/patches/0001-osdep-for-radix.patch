Adds Radix to the systems tmux knows, with its own osdep file: tmux
finds the program running in a pane, which it names the window after,
in the name line of /processes/<number>/status, as it finds it in
/proc/<number>/cmdline on Linux. And when cross-compiling for Radix,
configure takes the C library's reallocarray as working, as it is:
configure cannot run its test program then, and would build tmux's
own, which clashes with the C library's in a static program. The new
file is under tmux's ISC license, so that it can go upstream as it is.
Only the generated configure script changes: changing configure.ac too
would have make run autoconf again, which the build machine need not
have.

--- a/configure
+++ b/configure
@@ -5695,6 +5695,12 @@
 { $as_echo "$as_me:${as_lineno-$LINENO}: checking for working reallocarray" >&5
 $as_echo_n "checking for working reallocarray... " >&6; }
 if test "$cross_compiling" = yes; then :
+  case "$host_os" in
+  *radix*)
+ { $as_echo "$as_me:${as_lineno-$LINENO}: result: yes" >&5
+$as_echo "yes" >&6; }
+ ;;
+  *)
   case " $LIBOBJS " in
   *" reallocarray.$ac_objext "* ) ;;
   *) LIBOBJS="$LIBOBJS reallocarray.$ac_objext"
@@ -5702,6 +5708,8 @@
 esac
  { $as_echo "$as_me:${as_lineno-$LINENO}: result: no" >&5
 $as_echo "no" >&6; }
+ ;;
+  esac
 
 else
   cat confdefs.h - <<_ACEOF >conftest.$ac_ext
@@ -8351,6 +8359,11 @@
 $as_echo "haiku" >&6; }
 		PLATFORM=haiku
 		;;
+	*radix*)
+		{ $as_echo "$as_me:${as_lineno-$LINENO}: result: radix" >&5
+$as_echo "radix" >&6; }
+		PLATFORM=radix
+		;;
 	*)
 		{ $as_echo "$as_me:${as_lineno-$LINENO}: result: unknown" >&5
 $as_echo "unknown" >&6; }
