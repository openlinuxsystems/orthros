+
+// Sets a file's times by its path. On Radix through the path's directory:
+// a handle that may only read the file may not set them there.
+#[cfg(target_os = "radix")]
+fn set_path_times(p: &Path, atime: Option<FileTime>, mtime: Option<FileTime>) -> io::Result<()> {
+    imp::set_times(p, atime, mtime, false)
+}
+
+#[cfg(not(target_os = "radix"))]
+fn set_path_times(p: &Path, atime: Option<FileTime>, mtime: Option<FileTime>) -> io::Result<()> {
+    let mut times = fs::FileTimes::new();
+    if let Some(t) = atime {
+        times = times.set_accessed(t.into());
+    }
+    if let Some(t) = mtime {
+        times = times.set_modified(t.into());
+    }
+    imp::open(p)?.set_times(times)
 }
 
