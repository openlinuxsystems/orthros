new file mode 100644
--- /dev/null
+++ b/fuser-0.16.0/src/mnt/fuse_radix.rs
@@ -0,0 +1,22 @@
+//! Mounting on Radix, the kernel of Dukovo.
+//!
+//! Radix mounts a connection to `/devices/fuse` with a call of its own,
+//! radix-directory(2)'s `mount_fuse`, which `mount -t` makes for the
+//! filesystem's program: the program serves the descriptor it is handed
+//! with `Session::from_fd`. A mount by mount point is not offered.
+
+use super::mount_options::MountOption;
+use std::{fs::File, io, path::Path, sync::Arc};
+
+/// A mount, which Radix never makes here.
+#[derive(Debug)]
+pub struct Mount;
+
+impl Mount {
+    pub fn new(_mountpoint: &Path, _options: &[MountOption]) -> io::Result<(Arc<File>, Mount)> {
+        Err(io::Error::new(
+            io::ErrorKind::Unsupported,
+            "on Radix, mount with mount -t, and serve the connection with Session::from_fd",
+        ))
+    }
+}
