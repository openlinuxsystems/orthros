# GRUB configuration for the OrthrOS @VERSION@ boot image.
# `ob image` generates boot/grub/grub.cfg from image/grub/grub.cfg.in by
# filling in the VERSION, TIMEOUT and CMDLINE placeholders. See orthros-boot(7).

set timeout=@TIMEOUT@
set default=0

# Mirror the menu on the first serial port, where Radix also writes.
if serial --unit=0 --speed=115200; then
    terminal_input --append serial
    terminal_output --append serial
fi

menuentry "OrthrOS @VERSION@ (Radix)" {
    multiboot2 /boot/radix @CMDLINE@
    boot
}
