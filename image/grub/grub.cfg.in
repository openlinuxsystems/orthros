# GRUB configuration for the Dukovo Server @VERSION@ boot image.
# `ob image` generates boot/grub/grub.cfg from image/grub/grub.cfg.in by
# filling in the VERSION, TIMEOUT, CMDLINE, MODULES and ENTRIES
# placeholders; ENTRIES holds the disk check's entry of
# `ob image --disk-check`, or nothing. See dukovo-boot(7).

set timeout=@TIMEOUT@
set default=0

# Mirror the menu on the first serial port, where Radix also writes.
if serial --unit=0 --speed=115200; then
    terminal_input --append serial
    terminal_output --append serial
fi

# Radix draws its console into the framebuffer GRUB sets up. Only the
# firmware's video drivers are loaded, GOP under UEFI and VESA under BIOS, so
# QEMU boots the way real machines do; GRUB's native drivers for QEMU's
# display would otherwise take over there. Under UEFI the mode the firmware
# set, normally the panel's native resolution, is kept; under BIOS GRUB picks
# the display's preferred VESA mode.
if [ "${grub_platform}" = "efi" ]; then
    insmod efi_gop
    insmod efi_uga
    set gfxpayload=keep
else
    insmod vbe
fi

menuentry "Dukovo Server @VERSION@ (Radix)" {
    multiboot2 /boot/radix @CMDLINE@
@MODULES@    boot
}

# For a lost administrator's password: the sign-in first shows the
# startup-trouble menu (ADR 0253). The flag comes first, so it is the
# kernel's whatever the command line holds after a lone `--`.
menuentry "Dukovo Server @VERSION@: startup trouble" {
    multiboot2 /boot/radix startup-trouble @CMDLINE@
@MODULES@    boot
}
@ENTRIES@
