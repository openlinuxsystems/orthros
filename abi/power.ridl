//! The power capability (Phase 9, ADR 0099): turning the machine off,
//! restarting it or halting it, and hearing its power button (Phase 11,
//! ADR 0142).
//!
//! Spark gets the one capability to it when it starts and keeps it
//! (spark(8)): shutdown(8), reboot(8), poweroff(8) and halt(8) ask Spark,
//! which stops the services in order, then calls one of the first three
//! methods. Each first writes back every filesystem with changes (as
//! sync(2) does), logs what it does, and does not return once it has
//! worked. Pressing the power button asks Spark the same as poweroff(8).

module power;

/// The machine's power. Every method needs the control right.
interface power = 0x000e version 2 {
    kind = power;
    /// Turns the machine off: ACPI's S5 state on a PC. Fails with
    /// not_supported, after syncing, if the firmware gives no way to.
    method power_off = 1 () -> ()
        raises [no_such_slot, empty_slot, wrong_kind, missing_rights, not_supported];
    /// Restarts the machine, as its reset button would.
    method restart = 2 () -> ()
        raises [no_such_slot, empty_slot, wrong_kind, missing_rights];
    /// Stops every CPU with the machine still on, for it to be turned off
    /// by hand.
    method halt = 3 () -> ()
        raises [no_such_slot, empty_slot, wrong_kind, missing_rights];
    /// Signals the notification in slot `notification` each time the
    /// machine's power button is pressed, with the bits of that
    /// capability's badge (bit 0 if it has none): how Spark, waiting in
    /// `poll`, hears it. A later call replaces the notification. Fails
    /// with not_supported if the kernel cannot hear the button: on a PC,
    /// one that is not an ACPI fixed feature, whose presses only AML
    /// tells of. Needs the send right on the notification.
    method notify_button = 4 (notification: slot) -> ()
        raises [no_such_slot, empty_slot, wrong_kind, missing_rights, not_supported];
}
