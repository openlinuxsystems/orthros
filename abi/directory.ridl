//! Directories.
//!
//! Programs never name files by absolute path: they hold capabilities to
//! directories, and every path is resolved beneath the directory it is
//! given with. A path is names separated by `/`; `.` is the directory
//! itself, `..` its parent, but never above the directory the path starts
//! from, and a path that starts with `/` is refused (outside), as with
//! WASI's preopened directories and Capsicum. What a program can reach is
//! what its directory capabilities lead to. Spark holds the root of the
//! system's tree in SLOT_ROOT (radix-startup(2)) and hands out
//! capabilities to the parts each program needs.
//!
//! Symbolic links are followed as a path is resolved: a target that does
//! not start with `/` goes on from the link's directory, and one that
//! does starts again from the directory the path started from, as if it
//! were the root, so a link cannot lead out of it either. `..` at the
//! system's root stays there, as `/..` is `/`. A link that is the last
//! name of a path is followed too, unless the call says no_follow and no
//! `/` comes after it; `remove` and `rename` take the link itself. At
//! most 40 are followed in one call (too_many_links).
//!
//! Rights: the read right looks names up, lists and opens for reading;
//! the write right creates, removes and renames, and opens for writing;
//! the control right mounts and unmounts. A capability `open` makes has
//! the rights it asks for, which must be among the directory's own (for
//! a file: read and write; for a directory: read, write and control), the
//! directory's bypass right if it has it, and the copy and transfer
//! rights.
//!
//! The second gate (Phase 13, ADR 0214). A directory capability acts for
//! a name, a user with a group and up to GROUPS_MAX more (radix-names(2)),
//! which what is opened or made through it keeps; the caller's process
//! has its own for what it makes without a path, as pipes. Every call that
//! resolves a path checks the owners, groups and modes of the files it
//! meets against that name, as Linux checks a process's: the owner's bits
//! if the name's user owns the file, else the group's if its group is one
//! of the name's, else the others'. Resolving needs search (execute) on
//! each directory it looks in, this one included; opening needs read for
//! the read right and write for the write right or to truncate, but for a
//! file the call makes; listing needs read; making, removing and renaming
//! need write and search on the directory the name is in, and moving a
//! directory to another needs write on it. In a directory with the sticky
//! bit only the owner of a file or of the directory may remove or rename
//! it (not_permitted). Each failure is denied (EACCES) unless the method
//! says otherwise. A capability with the bypass right passes the second
//! gate, but for running a file that no execute bit lets anyone run
//! (radix-process(2)'s `exec`), as Linux's root does.

module directory;

/// The longest name in a directory, in bytes of UTF-8.
const NAME_MAX: u64 = 255;
/// The longest path a call takes, in bytes.
const PATH_MAX: u64 = 4096;
/// An owner, group or mode `set_access` leaves as it is.
const KEEP: u32 = 0xffff_ffff;
/// What `check_access` asks for: to read the file.
const READ_OK: u32 = 4;
/// To write it.
const WRITE_OK: u32 = 2;
/// To run it, or to search the directory.
const EXECUTE_OK: u32 = 1;
/// The bits a mode may have, 07777: read, write and execute for the
/// owner, the group and the others, with set-user-ID, set-group-ID and
/// sticky.
const MODE_BITS: u32 = 0xfff;

/// What a file is.
enum FileKind: u8 {
    /// A regular file.
    file = 0;
    /// A directory.
    directory = 1;
    /// A block device, which filesystems are mounted from.
    block_device = 2;
    /// A character device: `null`, `zero`, terminals and the like.
    char_device = 3;
    /// A pipe (radix-process(2)'s `pipe`).
    pipe = 4;
    /// A symbolic link (`make_link`).
    symlink = 5;
    /// A socket (radix-process(2)'s `socket_pair` and `socket`), or a
    /// socket's name (`bind_socket`).
    socket = 6;
}

/// What kind of filesystem one is.
enum FilesystemKind: u8 {
    /// Memory only: `tmpfs`.
    tmpfs = 0;
    /// FAT12, FAT16 or FAT32 on a disk: `fat`.
    fat = 1;
    /// The processes: `proc`.
    proc = 2;
    /// The kernel's devices and settings: `sys`.
    sys = 3;
    /// The devices: `dev`.
    dev = 4;
    /// The boot archive, read-only: `bootfs`.
    bootfs = 5;
    /// Pipes and pseudo-terminals, which live outside the tree (Phase 8):
    /// `pipefs`.
    pipe = 6;
    /// Btrfs on a disk: `btrfs`.
    btrfs = 7;
    /// exFAT on a disk: `exfat`.
    exfat = 8;
    /// ext4, or ext2 or ext3, on a disk: `ext4`.
    ext4 = 9;
}

/// How `open` opens.
flags OpenFlags: u32 {
    /// Make the file if it does not exist (needs the write right); a
    /// directory fails with is_directory, and with `directory`
    /// invalid_argument, as Linux has it.
    create = 0;
    /// With `create`: fail with exists if it does.
    exclusive = 1;
    /// Cut the file to 0 bytes (needs the write right); a directory fails
    /// with is_directory.
    truncate = 2;
    /// Fail with not_directory unless it is a directory.
    directory = 3;
    /// The description appends (radix-file(2)'s DescriptionFlags).
    append = 4;
    /// The description does not wait (radix-file(2)'s DescriptionFlags).
    non_blocking = 5;
    /// Opening a terminal does not make it the controlling terminal of
    /// the caller's session.
    no_terminal = 6;
    /// The slot is emptied by radix-process(2)'s `exec`.
    close_on_exec = 7;
    /// Fail with too_many_links if the last name is a symbolic link, as
    /// O_NOFOLLOW does.
    no_follow = 8;
}

/// How `stat`, `set_times` and `set_access` find what they look at.
flags PathFlags: u32 {
    /// A symbolic link that is the last name is taken itself, not what it
    /// points to, as AT_SYMLINK_NOFOLLOW has it.
    no_follow = 0;
}

/// How `link` takes its path.
flags LinkFlags: u32 {
    /// A symbolic link that is the last name is followed, as
    /// AT_SYMLINK_FOLLOW has it.
    follow = 0;
}

/// How a filesystem is mounted.
flags MountFlags: u32 {
    /// Refuse every change.
    read_only = 0;
    /// Compress the data written with zstd, as Linux's `compress=zstd:1`
    /// does: `btrfs` only.
    compress = 1;
}

/// Which chunks a balance moves (ADR 0159): those of data, of metadata,
/// and of the chunk tree; and, of each kind, whether chunks already of
/// the profile it converts to stay, as btrfs-balance(8)'s `soft` filter
/// has it.
flags BalanceKinds: u32 {
    /// Move the chunks of data.
    data = 0;
    /// Move the chunks of metadata.
    metadata = 1;
    /// Move the chunks of the chunk tree.
    system = 2;
    /// Leave the data chunks already of the profile `convert_data` names.
    soft_data = 3;
    /// Leave the metadata chunks already of the profile
    /// `convert_metadata` names.
    soft_metadata = 4;
    /// Leave the chunk tree's chunks already of the profile
    /// `convert_system` names.
    soft_system = 5;
}

/// A quota group `qgroups` writes (ADR 0170): one for each subvolume of
/// a Btrfs filesystem with simple quotas, as `btrfs qgroup show` lists
/// them.
struct Qgroup {
    /// Its ID, as Linux's: the level in the high 16 bits, 0 for a
    /// subvolume's, and the subvolume's ID below.
    id: u64;
    /// The bytes of the extents its subvolume made, data and tree
    /// blocks, as simple quotas count them: each extent to the subvolume
    /// that wrote it, whoever shares it since.
    referenced: u64;
    /// The same bytes: simple quotas count each extent once.
    exclusive: u64;
    /// The most `referenced` may grow to; all ones for no limit.
    max_referenced: u64;
    /// The most `exclusive` may grow to; all ones for no limit.
    max_exclusive: u64;
}

/// An entry `list` writes: this header, then the name's bytes, then
/// zeros up to a multiple of 8 bytes.
struct DirEntry {
    /// The cursor that continues the listing after this entry.
    next: u64;
    /// What it is: a FileKind.
    kind: u8;
    /// Zero.
    pad: u8;
    /// The length of its name in bytes.
    name_len: u16;
    /// Zero.
    reserved: u32;
}

/// What a file is, as `stat` writes it (ADR 0135).
struct FileStatus {
    /// Its size in bytes; a symbolic link's is its target's length.
    size: u64;
    /// The bytes it takes on its filesystem.
    allocated: u64;
    /// A number unique on its filesystem while it exists.
    id: u64;
    /// The number of the mount it is on, unique since boot.
    mount: u64;
    /// When it was made, in nanoseconds since 1970 (0 if unknown).
    created: u64;
    /// When its contents last changed, likewise.
    modified: u64;
    /// When it was last read, likewise.
    accessed: u64;
    /// When it last changed in any way, its contents or what is said of
    /// it (its names, times or size), likewise.
    changed: u64;
    /// The number of the device a device node stands for, its major
    /// number in the high 32 bits (`make_node`); 0 for any other file.
    device: u64;
    /// How many names it has: 1 for a file with none of its own in the
    /// tree, and for a directory whose filesystem does not count them.
    links: u32;
    /// What it is: a FileKind.
    kind: u8;
    /// Zero.
    pad: u8;
    /// Its permission bits, as POSIX's `st_mode & 07777` (ADR 0213): what
    /// its filesystem keeps, or for one that keeps none (FAT, exFAT, and
    /// the kernel's own trees) 0755 for a directory, 0644 for a file,
    /// and as Linux shows them for the rest.
    mode: u16;
    /// The number of the user it belongs to; 0 where its filesystem keeps
    /// none.
    owner: u32;
    /// The number of its group, likewise.
    group: u32;
}

/// What `scrub` read and found, counted as Linux's
/// `struct btrfs_scrub_progress` counts it, in its order (ADR 0150): each
/// copy of a block is counted, and the errors a sector at a time.
struct ScrubProgress {
    /// The data extents read, a copy each.
    data_extents: u64;
    /// The tree blocks read, a copy each.
    tree_extents: u64;
    /// The bytes of data read.
    data_bytes: u64;
    /// The bytes of tree blocks read.
    tree_bytes: u64;
    /// The sectors the disk failed to read.
    read_errors: u64;
    /// The sectors whose checksum differs.
    csum_errors: u64;
    /// The sectors of tree blocks whose checksum matches but whose header
    /// does not.
    verify_errors: u64;
    /// The data sectors with no checksum.
    no_csum: u64;
    /// The checksums of data no extent holds.
    csum_discards: u64;
    /// The copies of the superblock that are bad or old.
    super_errors: u64;
    /// The times memory ran out.
    malloc_errors: u64;
    /// The sectors with no good copy.
    uncorrectable_errors: u64;
    /// The bad sectors with a good copy, written over them unless the
    /// scrub only read.
    corrected_errors: u64;
    /// Where on the device the scrub got to, in bytes.
    last_physical: u64;
    /// The errors a second read did not show.
    unverified_errors: u64;
    /// The filesystem's UUID.
    fsid: [u8; 16];
}

/// A directory.
interface directory = 0x000b version 7 {
    kind = directory;
    /// Opens the file or directory at `path` (`.` for this one) and puts
    /// a capability to it with `rights` in slot `to`. Returns what it is.
    /// A file it makes has the permission bits `mode` (MODE_BITS at most,
    /// or invalid_argument) less those of the caller's file mode mask
    /// (radix-process(2)'s `file_mask`), and belongs to the caller's user
    /// and group, or to the directory's group if it has the set-group-ID
    /// bit; `mode` is not looked at otherwise. Needs the read right, and
    /// the write right to create or truncate or to ask for it.
    method open = 1 (path: in bytes, flags: OpenFlags, rights: Rights, to: slot, mode: u32)
        -> (kind: FileKind)
        raises [no_such_slot, empty_slot, missing_rights, occupied, invalid_argument, no_memory,
                bad_address, not_found, exists, not_directory, is_directory, read_only, no_space,
                quota_exceeded, name_too_long, bad_name, outside, io, corrupt, no_device,
                too_many_links, denied];
    /// Makes an empty directory at `path`, with the mode and owners `open`
    /// gives a file it makes, and the set-group-ID bit too if this
    /// directory has it. Needs the write right.
    method make_directory = 2 (path: in bytes, mode: u32) -> ()
        raises [no_such_slot, empty_slot, missing_rights, invalid_argument, no_memory, bad_address,
                not_found, exists, not_directory, read_only, no_space, quota_exceeded,
                name_too_long, bad_name, outside, io, corrupt, too_many_links, denied];
    /// Removes the file, symbolic link or empty directory, an empty Btrfs
    /// subvolume too, at `path`. A file still open lives on until its last
    /// capability goes. Needs the write right.
    method remove = 3 (path: in bytes) -> ()
        raises [no_such_slot, empty_slot, missing_rights, invalid_argument, no_memory,
                bad_address, not_found, not_directory, not_empty, read_only, name_too_long,
                bad_name, outside, in_use, io, corrupt, too_many_links, denied, not_permitted];
    /// Moves the file or directory at `from` to `to` beneath the
    /// directory in slot `to_dir`, on the same filesystem, replacing a
    /// file (or an empty directory, for a directory) there. Needs the
    /// write right on both.
    method rename = 4 (from: in bytes, to_dir: slot, to: in bytes) -> ()
        raises [no_such_slot, empty_slot, wrong_kind, missing_rights, invalid_argument, no_memory,
                bad_address, not_found, not_directory, is_directory, not_empty, read_only, no_space,
                quota_exceeded, name_too_long, bad_name, outside, cross_mount, in_use, io, corrupt,
                too_many_links, denied, not_permitted];
    /// Writes the directory's entries from `cursor` (0 for the first) into
    /// `buffer` as DirEntry records, other than `.` and `..`; returns how
    /// many it wrote (0 at the end), the bytes they take, and the cursor
    /// that continues after them. Needs the read right.
    method list = 5 (cursor: u64, buffer: out bytes) -> (count: u32, used: u64, next: u64)
        raises [no_such_slot, empty_slot, missing_rights, invalid_argument, bad_address, io,
                corrupt, denied];
    /// Writes what the file at `path` (`.` for this directory) is into
    /// `buffer`, as a FileStatus; a buffer smaller than one fails with
    /// invalid_argument. Needs the read right.
    method stat = 6 (path: in bytes, flags: PathFlags, buffer: out bytes) -> ()
        raises [no_such_slot, empty_slot, missing_rights, invalid_argument, no_memory,
                bad_address, not_found, not_directory, name_too_long, bad_name, outside, io,
                corrupt, too_many_links, denied];
    /// Mounts a filesystem of kind `filesystem` (its name, as
    /// FilesystemKind lists them) on the directory at `path`: `fat`,
    /// `exfat`, `btrfs` and `ext4` on the block device whose file capability
    /// is in slot `source`, the others with `source` 0. With `bind` instead,
    /// the directory whose capability is in slot `source` is mounted there
    /// too, as Linux's bind mounts are, read-only if its own mount is. A
    /// second mount on a directory stacks on the first. Needs the control
    /// right, and the read right on `source` (and the write right unless
    /// `flags` has read_only). A Btrfs that Radix cannot write yet, or an
    /// ext4 with features Radix only reads, fails with invalid_argument
    /// unless `flags` has read_only, as on Linux, and so does compress for
    /// a filesystem other than `btrfs`.
    method mount = 7 (path: in bytes, filesystem: in bytes, source: u32, flags: MountFlags) -> ()
        raises [no_such_slot, empty_slot, wrong_kind, missing_rights, invalid_argument, no_memory,
                bad_address, not_found, not_directory, name_too_long, bad_name, outside, in_use, io,
                corrupt, unknown_filesystem, not_block_device, too_many_links, denied];
    /// Unmounts the filesystem whose root is at `path`, after writing what
    /// it holds in memory to its disk. Fails with in_use while anything
    /// is mounted on it or open on it. Needs the control right.
    method unmount = 8 (path: in bytes) -> ()
        raises [no_such_slot, empty_slot, missing_rights, invalid_argument, no_memory,
                bad_address, not_found, not_directory, name_too_long, bad_name, outside, in_use,
                io, corrupt, too_many_links, denied];
    /// Writes everything the directory's filesystem holds in memory to its
    /// disk.
    method sync = 9 () -> ()
        raises [no_such_slot, empty_slot, io, corrupt];
    /// The directory's filesystem: its kind, how it is mounted, its block
    /// size, blocks and free blocks, and how many files and directories it
    /// holds at most and how many more it can take (both zero when it
    /// keeps no count, as FAT does). Needs the read right.
    method info = 10 ()
        -> (filesystem: FilesystemKind, flags: MountFlags, block_size: u32, blocks: u64, free: u64,
            files: u64, free_files: u64)
        raises [no_such_slot, empty_slot, missing_rights];
    /// Sets the times of the file or directory at `path` (`.` for this
    /// one), as radix-file(2)'s `set_times` does. Needs the write right.
    /// Setting a time to one given needs the file's owner or the bypass
    /// right (not_permitted); setting both to now needs that or write
    /// permission on it, as touch(1) needs.
    method set_times = 11 (path: in bytes, accessed: u64, modified: u64, flags: PathFlags) -> ()
        raises [no_such_slot, empty_slot, missing_rights, invalid_argument, no_memory,
                bad_address, not_found, not_directory, name_too_long, bad_name, outside,
                not_permitted, read_only, io, corrupt, too_many_links, denied];
    /// Makes a symbolic link at `path` that points to `target`: any text
    /// of at most PATH_MAX bytes but the empty one and one with a NUL,
    /// which is not looked at until the link is followed. A filesystem
    /// that has no links, as FAT has none, refuses with not_permitted.
    /// Needs the write right.
    method make_link = 12 (path: in bytes, target: in bytes) -> ()
        raises [no_such_slot, empty_slot, missing_rights, invalid_argument, no_memory, bad_address,
                not_found, exists, not_directory, read_only, no_space, quota_exceeded,
                name_too_long, bad_name, outside, io, corrupt, not_permitted, too_many_links,
                denied];
    /// Reads where the symbolic link at `path` points into `buffer`;
    /// returns the target's length, which is more than `buffer` holds if
    /// it was cut short. Fails with not_link if it is not a link. Needs
    /// the read right.
    method read_link = 13 (path: in bytes, buffer: out bytes) -> (len: u64)
        raises [no_such_slot, empty_slot, missing_rights, invalid_argument, no_memory,
                bad_address, not_found, not_directory, name_too_long, bad_name, outside, io,
                corrupt, not_link, too_many_links, denied];
    /// Writes where `path` leads into `buffer`: the names from this
    /// directory that resolving it took, every symbolic link followed and
    /// `.` and `..` worked out, joined by `/` (`.` for this directory
    /// itself), as realpath(3) wants. Returns its length, which is more
    /// than `buffer` holds if it was cut short. Needs the read right.
    method real_path = 14 (path: in bytes, buffer: out bytes) -> (len: u64)
        raises [no_such_slot, empty_slot, missing_rights, invalid_argument, no_memory,
                bad_address, not_found, not_directory, name_too_long, bad_name, outside, io,
                corrupt, too_many_links, denied];
    /// Names the socket in slot `socket` (radix-process(2)'s `socket`)
    /// `path`: makes a socket's name there, a file of kind socket, which
    /// `connect_socket` connects through while the socket listens. The
    /// socket keeps `name` (at most radix-file(2)'s SOCKET_NAME_MAX bytes)
    /// as its name for radix-file(2)'s `socket_name`: the path as the
    /// program gave it. A socket takes one name, before it listens or
    /// connects; the name stays until it is removed, and once the socket
    /// is gone, connecting through it fails with refused. Opening it fails
    /// with no_device. Its mode is 0777 less the caller's file mode mask,
    /// as on Linux. FAT has no such files (not_permitted). Needs the
    /// write right, and the write right on the socket.
    method bind_socket = 15 (path: in bytes, socket: slot, name: in bytes) -> ()
        raises [no_such_slot, empty_slot, wrong_kind, missing_rights, invalid_argument, no_memory,
                bad_address, not_found, exists, not_directory, read_only, no_space, quota_exceeded,
                name_too_long, bad_name, outside, io, corrupt, not_permitted, too_many_links,
                not_socket, busy, denied];
    /// Connects the socket in slot `socket`, which must be neither
    /// connected nor listening, to the socket listening at the name
    /// `path`: the connection waits there until radix-file(2)'s `accept`
    /// takes it, and the socket can send and receive at once. While as
    /// many connections wait as the listening socket allows, it waits
    /// for room, or fails with would_block if the socket's description
    /// is non_blocking. A name of a socket that does not listen, or is
    /// gone, and any other file, fail with refused. Needs the write right,
    /// and the write right on the socket.
    method connect_socket = 16 (path: in bytes, socket: slot) -> ()
        raises [no_such_slot, empty_slot, wrong_kind, missing_rights, invalid_argument,
                no_memory, bad_address, not_found, not_directory, name_too_long, bad_name,
                outside, io, corrupt, too_many_links, not_socket, refused, connected, busy,
                would_block, interrupted, denied];
    /// Makes `to` beneath the directory in slot `to_dir` another name of
    /// the file at `path`, a hard link: of the symbolic link itself when
    /// `path` ends in one, unless `flags` has follow, as linkat(2) has
    /// it. Not a directory (is_directory); on the same filesystem (and
    /// Btrfs subvolume), or cross_mount. A filesystem that has no hard
    /// links, as FAT has none, refuses with not_permitted, and a file
    /// with as many names as it keeps fails with too_many_names. Needs
    /// the write right on `to_dir`, and the file's owner or read and
    /// write permission on it (not_permitted), as Linux's
    /// `fs.protected_hardlinks` has it.
    method link = 17 (path: in bytes, flags: LinkFlags, to_dir: slot, to: in bytes) -> ()
        raises [no_such_slot, empty_slot, wrong_kind, missing_rights, invalid_argument, no_memory,
                bad_address, not_found, exists, not_directory, is_directory, read_only, no_space,
                quota_exceeded, name_too_long, bad_name, outside, cross_mount, io, corrupt,
                not_permitted, too_many_links, too_many_names, denied];
    /// Makes a file of `kind` at `path`: a named pipe (pipe), which
    /// opening reads or writes as a pipe; a device node (char_device or
    /// block_device) that stands for device number `device`, as
    /// FileStatus has it, which opening opens that device through
    /// (radix-files(7)); an empty file (file); or a socket's name that
    /// no socket listens at (socket). Any other kind fails with
    /// invalid_argument. It has `mode` and owners as `open` gives a file
    /// it makes. A filesystem that keeps none, as FAT keeps none, refuses
    /// with not_permitted. Needs the write right.
    method make_node = 18 (path: in bytes, kind: FileKind, device: u64, mode: u32) -> ()
        raises [no_such_slot, empty_slot, missing_rights, invalid_argument, no_memory, bad_address,
                not_found, exists, not_directory, read_only, no_space, quota_exceeded,
                name_too_long, bad_name, outside, io, corrupt, not_permitted, too_many_links,
                denied];
    /// Makes a new, empty Btrfs subvolume at `path`, as
    /// btrfs-subvolume(8)'s `create` does: a directory whose files are a
    /// tree of their own, which `snapshot` copies at once (ADR 0138).
    /// Other filesystems fail with invalid_argument. Needs the write
    /// right.
    method make_subvolume = 19 (path: in bytes) -> ()
        raises [no_such_slot, empty_slot, missing_rights, invalid_argument, no_memory, bad_address,
                not_found, exists, not_directory, read_only, no_space, quota_exceeded,
                name_too_long, bad_name, outside, io, corrupt, too_many_links, denied];
    /// Makes `to` beneath the directory in slot `to_dir` a snapshot of
    /// the Btrfs subvolume that holds `path`, read-only if `read_only`, as
    /// btrfs-subvolume(8)'s `snapshot` makes one: what the subvolume holds
    /// now, what was written but not yet synced included, in blocks the
    /// two share until either changes them. A subvolume in the source is
    /// an empty directory in the snapshot, as on Linux. On the same
    /// filesystem, or cross_mount; other filesystems fail with
    /// invalid_argument. Needs the write right on `to_dir`, and the
    /// subvolume's owner or the bypass right (not_permitted).
    method snapshot = 20 (path: in bytes, to_dir: slot, to: in bytes, read_only: bool) -> ()
        raises [no_such_slot, empty_slot, wrong_kind, missing_rights, invalid_argument, no_memory,
                bad_address, not_found, exists, not_directory, read_only, no_space, quota_exceeded,
                name_too_long, bad_name, outside, cross_mount, io, corrupt, too_many_links, denied,
                not_permitted];
    /// Removes the Btrfs subvolume at `path` with everything in it, as
    /// btrfs-subvolume(8)'s `delete` does, freeing what no snapshot
    /// shares; `remove` takes an empty one too. Fails with not_empty while
    /// it holds a subvolume, with in_use while a file in it is open or
    /// while it is the filesystem's default subvolume (Linux lets open
    /// files live on, and refuses the default with EPERM), and with
    /// invalid_argument if it is no subvolume. Needs the write right, and
    /// write and search permission on the subvolume as well as what
    /// `remove` needs, as Linux's `user_subvol_rm_allowed` has it.
    method remove_subvolume = 21 (path: in bytes) -> ()
        raises [no_such_slot, empty_slot, missing_rights, invalid_argument, no_memory, bad_address,
                not_found, not_directory, not_empty, read_only, no_space, name_too_long, bad_name,
                outside, in_use, io, corrupt, too_many_links, denied, not_permitted];
    /// Reads every block of the directory's Btrfs filesystem that its
    /// last commit holds, every copy, and checks each against its
    /// checksum, as btrfs-scrub(8)'s `start -B` does; with `repair`, writes
    /// a good copy over each bad one. Writes what it read and found into
    /// `buffer`, as a ScrubProgress; a buffer smaller than one fails with
    /// invalid_argument. Other filesystems fail with not_supported, and
    /// `repair` on a read-only mount with read_only. Needs the read
    /// right, and the write right to repair.
    method scrub = 22 (repair: bool, buffer: out bytes) -> ()
        raises [no_such_slot, empty_slot, missing_rights, invalid_argument, no_memory,
                bad_address, not_supported, read_only, io, corrupt];
    /// Puts the block device whose file capability is in slot `device` in
    /// the place of the disk of device ID `devid` of the directory's Btrfs
    /// filesystem, there or missing, and rebuilds onto it from the copies
    /// on its other disks, as btrfs-replace(8)'s `start -B` does (ADR
    /// 0155): the new disk takes the old one's ID and UUID, and the old
    /// one, if it is there, has its superblocks wiped once the new one
    /// holds every copy. Writes what the rebuild read and found into
    /// `buffer`, as a ScrubProgress. Fails with not_found if no disk has
    /// that ID, in_use if the device is a disk of a mounted Btrfs, holds a
    /// mount or is a swap area, no_space if it is smaller than the disk it
    /// replaces, not_supported on other filesystems and when the other
    /// disks lack a copy of a chunk on it, read_only on a read-only mount,
    /// and io if the new disk fails, which then is left out. Needs the
    /// control right, and the read and write rights on `device`.
    method replace_disk = 23 (devid: u64, device: u32, buffer: out bytes) -> ()
        raises [no_such_slot, empty_slot, wrong_kind, missing_rights, invalid_argument,
                no_memory, bad_address, not_found, not_supported, read_only, in_use,
                no_space, not_block_device, io, corrupt];
    /// Discards on the disks of the directory's filesystem the bytes it
    /// does not use, in ranges of at least `minimum` bytes, as Linux's
    /// FITRIM does for fstrim(8) (ADR 0158): on Btrfs, the free space of
    /// each block group on every copy, and each disk's bytes no chunk
    /// takes, never a superblock. Returns how many bytes were discarded,
    /// each copy counted. Fails with not_supported on other filesystems
    /// and when no disk discards, read_only on a read-only mount, and io
    /// if a disk fails a discard, after the others are done. Needs the
    /// control right.
    method trim = 24 (minimum: u64) -> (trimmed: u64)
        raises [no_such_slot, empty_slot, missing_rights, no_memory, not_supported,
                read_only, io, corrupt];
    /// Adds the block device whose file capability is in slot `device` to
    /// the disks of the directory's Btrfs filesystem, as btrfs-device(8)'s
    /// `add` does (ADR 0159), and returns the device ID it takes. Its old
    /// superblocks are wiped first; it holds nothing until new chunks go
    /// on it or a balance moves some there. Fails with in_use if the
    /// device is a disk of a mounted Btrfs, holds a mount or is a swap
    /// area, no_space if it is smaller than 64 MiB, not_supported on other
    /// filesystems, when its blocks are larger than the filesystem's
    /// sectors, and once 16 disks have been the filesystem's since the
    /// mount, and read_only on a read-only mount. Needs the control right,
    /// and the read and write rights on `device`.
    method add_disk = 25 (device: u32) -> (devid: u64)
        raises [no_such_slot, empty_slot, wrong_kind, missing_rights, no_memory,
                not_supported, read_only, in_use, no_space, not_block_device, io, corrupt];
    /// Moves every chunk off the disk of device ID `devid` of the
    /// directory's Btrfs filesystem, there or missing, then takes the disk
    /// out, as btrfs-device(8)'s `remove` does (ADR 0159); a disk that is
    /// there has its superblocks wiped. Fails with not_found if no disk
    /// has that ID, invalid_argument if the disks left would be too few
    /// for a profile the filesystem uses, no_space if they lack room for
    /// its chunks, not_supported on other filesystems, read_only on a
    /// read-only mount, and io if a block has no copy that reads. Needs
    /// the control right.
    method remove_disk = 26 (devid: u64) -> ()
        raises [no_such_slot, empty_slot, missing_rights, invalid_argument, no_memory,
                not_found, not_supported, read_only, no_space, io, corrupt];
    /// Moves the chunks of the directory's Btrfs filesystem that `kinds`
    /// names to new chunks, as btrfs-balance(8)'s `start` does (ADR 0159),
    /// converting those of each kind to the profile its `convert_` names
    /// unless that is 0: a Btrfs block group profile flag, or 1 << 48 for
    /// single, as Linux's balance arguments have them. Returns how many
    /// chunks it looked at and how many it moved; a balance that fails
    /// part way leaves those it moved moved. Fails with invalid_argument
    /// for a profile Btrfs does not have or one that needs more disks than
    /// are there, not_supported for RAID5 and RAID6, for a convert of
    /// chunks that mix data and metadata, and on other filesystems,
    /// no_space when there is no room to move a chunk, read_only on a
    /// read-only mount, and io if a block has no copy that reads. Needs
    /// the control right.
    method balance = 27 (kinds: BalanceKinds, convert_data: u64, convert_metadata: u64,
                         convert_system: u64) -> (considered: u64, moved: u64)
        raises [no_such_slot, empty_slot, missing_rights, invalid_argument, no_memory,
                not_supported, read_only, no_space, io, corrupt];
    /// Turns simple quotas on for the directory's Btrfs filesystem, with
    /// `enable`, or off, as btrfs-quota(8)'s `enable --simple` and
    /// `disable` do (ADR 0170). On, each subvolume has a quota group that
    /// counts the bytes of the extents it writes from then on, and may be
    /// given a limit; off, the counts and limits go. Turning on what is on
    /// already, or off what is off, does nothing. Fails with not_supported
    /// on other filesystems and on a Btrfs with Linux's full quota groups,
    /// and read_only on a read-only mount. Needs the control right.
    method quota = 28 (enable: bool) -> ()
        raises [no_such_slot, empty_slot, missing_rights, no_memory, not_supported, read_only,
                no_space, io, corrupt];
    /// Writes the quota groups of the directory's Btrfs filesystem into
    /// `buffer` as Qgroup records, in order of their IDs, as many as fit;
    /// returns how many there are (ADR 0170). Fails with not_supported on
    /// other filesystems and when quotas are off. Needs the read right.
    method qgroups = 29 (buffer: out bytes) -> (count: u64)
        raises [no_such_slot, empty_slot, missing_rights, no_memory, bad_address,
                not_supported, io, corrupt];
    /// Sets the limits of quota group `id` of the directory's Btrfs
    /// filesystem, as btrfs-qgroup(8)'s `limit` does (ADR 0170): a change
    /// that would take its `referenced` past `max_referenced`, or its
    /// `exclusive` past `max_exclusive`, fails with quota_exceeded; all
    /// ones is no limit. Fails with not_found if no quota group has that
    /// ID, not_supported on other filesystems and when quotas are off, and
    /// read_only on a read-only mount. Needs the control right.
    method limit_qgroup = 30 (id: u64, max_referenced: u64, max_exclusive: u64) -> ()
        raises [no_such_slot, empty_slot, missing_rights, no_memory, not_found, not_supported,
                read_only, no_space, io, corrupt];
    /// Changes the owner, group or permission bits of the file or
    /// directory at `path` (`.` for this one), as chown(2) and chmod(2)
    /// do (ADR 0213); each that is KEEP stays. A change of owner or group,
    /// even to the same, takes a file's set-user-ID bit away, and its
    /// set-group-ID bit if its group may run it, as Linux does; a new
    /// `mode` (MODE_BITS at most, or invalid_argument) is set after that.
    /// A symbolic link's mode cannot change (not_supported, with
    /// no_follow). A filesystem that keeps no owners or modes, as FAT
    /// keeps none, takes a change of permission bits alone, or to owner
    /// and group 0, and changes nothing, as Linux's vfat does, and refuses
    /// any other with not_permitted. Needs the write right. Changing the
    /// owner needs the bypass right; the group, the file's owner, to a
    /// group of the name's, or the bypass right; the mode, the owner or
    /// the bypass right, and without that right a file whose group is
    /// not one of the name's loses its set-group-ID bit, as on Linux. Each
    /// fails with not_permitted otherwise.
    method set_access = 31 (path: in bytes, flags: PathFlags, owner: u32, group: u32, mode: u32)
        -> ()
        raises [no_such_slot, empty_slot, missing_rights, invalid_argument, no_memory,
                bad_address, not_found, not_directory, name_too_long, bad_name, outside,
                not_permitted, not_supported, read_only, no_space, quota_exceeded, io, corrupt,
                too_many_links, denied];
    /// Says whether the name this capability acts for may do what `want`
    /// asks with the file or directory at `path` (`.` for this one): read
    /// it (READ_OK), write it (WRITE_OK) or run or search it (EXECUTE_OK),
    /// or with none of them only that it is there, as access(2) and
    /// faccessat(2) ask. Fails with denied if the second gate refuses, and
    /// with read_only for WRITE_OK on a file of a read-only mount but a
    /// device, pipe or socket. Needs the read right.
    method check_access = 32 (path: in bytes, flags: PathFlags, want: u32) -> ()
        raises [no_such_slot, empty_slot, missing_rights, invalid_argument, no_memory,
                bad_address, not_found, not_directory, name_too_long, bad_name, outside,
                read_only, io, corrupt, too_many_links, denied];
}
