//! Directories.
//!
//! Programs never name files by absolute path: they hold capabilities to
//! directories, and every path is resolved beneath the directory it is
//! given with. A path is names separated by `/`; `.` is the directory
//! itself, `..` its parent, but never above the directory the path starts
//! from, and a path that starts with `/` is refused (outside), as with
//! WASI's preopened directories and Capsicum. What a program can reach is
//! what its directory capabilities lead to. Spark holds the root of the
//! system's tree in SLOT_ROOT (radix-startup(2)) and hands out
//! capabilities to the parts each program needs.
//!
//! Symbolic links are followed as a path is resolved: a target that does
//! not start with `/` goes on from the link's directory, and one that
//! does starts again from the directory the path started from, as if it
//! were the root, so a link cannot lead out of it either. `..` at the
//! system's root stays there, as `/..` is `/`. A link that is the last
//! name of a path is followed too, unless the call says no_follow and no
//! `/` comes after it; `remove` and `rename` take the link itself. At
//! most 40 are followed in one call (too_many_links).
//!
//! Rights: the read right looks names up, lists and opens for reading;
//! the write right creates, removes and renames, and opens for writing;
//! the control right mounts and unmounts. A capability `open` makes has
//! the rights it asks for, which must be among the directory's own (for
//! a file: read and write; for a directory: read, write and control), and
//! the copy and transfer rights.

module directory;

/// The longest name in a directory, in bytes of UTF-8.
const NAME_MAX: u64 = 255;
/// The longest path a call takes, in bytes.
const PATH_MAX: u64 = 4096;

/// What a file is.
enum FileKind: u8 {
    /// A regular file.
    file = 0;
    /// A directory.
    directory = 1;
    /// A block device, which filesystems are mounted from.
    block_device = 2;
    /// A character device: `null`, `zero`, terminals and the like.
    char_device = 3;
    /// A pipe (radix-process(2)'s `pipe`).
    pipe = 4;
    /// A symbolic link (`make_link`).
    symlink = 5;
    /// A socket (radix-process(2)'s `socket_pair` and `socket`), or a
    /// socket's name (`bind_socket`).
    socket = 6;
}

/// What kind of filesystem one is.
enum FilesystemKind: u8 {
    /// Memory only: `tmpfs`.
    tmpfs = 0;
    /// FAT12, FAT16 or FAT32 on a disk: `fat`.
    fat = 1;
    /// The processes: `proc`.
    proc = 2;
    /// The kernel's devices and settings: `sys`.
    sys = 3;
    /// The devices: `dev`.
    dev = 4;
    /// The boot archive, read-only: `bootfs`.
    bootfs = 5;
    /// Pipes and pseudo-terminals, which live outside the tree (Phase 8):
    /// `pipefs`.
    pipe = 6;
}

/// How `open` opens.
flags OpenFlags: u32 {
    /// Make the file if it does not exist (needs the write right); a
    /// directory fails with is_directory, and with `directory`
    /// invalid_argument, as Linux has it.
    create = 0;
    /// With `create`: fail with exists if it does.
    exclusive = 1;
    /// Cut the file to 0 bytes (needs the write right); a directory fails
    /// with is_directory.
    truncate = 2;
    /// Fail with not_directory unless it is a directory.
    directory = 3;
    /// The description appends (radix-file(2)'s DescriptionFlags).
    append = 4;
    /// The description does not wait (radix-file(2)'s DescriptionFlags).
    non_blocking = 5;
    /// Opening a terminal does not make it the controlling terminal of
    /// the caller's session.
    no_terminal = 6;
    /// The slot is emptied by radix-process(2)'s `exec`.
    close_on_exec = 7;
    /// Fail with too_many_links if the last name is a symbolic link, as
    /// O_NOFOLLOW does.
    no_follow = 8;
}

/// How `stat` and `set_times` find what they look at.
flags PathFlags: u32 {
    /// A symbolic link that is the last name is taken itself, not what it
    /// points to, as AT_SYMLINK_NOFOLLOW has it.
    no_follow = 0;
}

/// How a filesystem is mounted.
flags MountFlags: u32 {
    /// Refuse every change.
    read_only = 0;
}

/// An entry `list` writes: this header, then the name's bytes, then
/// zeros up to a multiple of 8 bytes.
struct DirEntry {
    /// The cursor that continues the listing after this entry.
    next: u64;
    /// What it is: a FileKind.
    kind: u8;
    /// Zero.
    pad: u8;
    /// The length of its name in bytes.
    name_len: u16;
    /// Zero.
    reserved: u32;
}

/// A directory.
interface directory = 0x000b version 4 {
    kind = directory;
    /// Opens the file or directory at `path` (`.` for this one) and puts
    /// a capability to it with `rights` in slot `to`. Returns what it is.
    /// Needs the read right, and the write right to create or truncate or
    /// to ask for it.
    method open = 1 (path: in bytes, flags: OpenFlags, rights: Rights, to: slot) -> (kind: FileKind)
        raises [no_such_slot, empty_slot, missing_rights, occupied, invalid_argument, no_memory,
                bad_address, not_found, exists, not_directory, is_directory, read_only, no_space,
                name_too_long, bad_name, outside, io, corrupt, no_device, too_many_links];
    /// Makes an empty directory at `path`. Needs the write right.
    method make_directory = 2 (path: in bytes) -> ()
        raises [no_such_slot, empty_slot, missing_rights, invalid_argument, no_memory,
                bad_address, not_found, exists, not_directory, read_only, no_space,
                name_too_long, bad_name, outside, io, corrupt, too_many_links];
    /// Removes the file, symbolic link or empty directory at `path`. A
    /// file still open lives on until its last capability goes. Needs the
    /// write right.
    method remove = 3 (path: in bytes) -> ()
        raises [no_such_slot, empty_slot, missing_rights, invalid_argument, no_memory,
                bad_address, not_found, not_directory, not_empty, read_only, name_too_long,
                bad_name, outside, in_use, io, corrupt, too_many_links];
    /// Moves the file or directory at `from` to `to` beneath the
    /// directory in slot `to_dir`, on the same filesystem, replacing a
    /// file (or an empty directory, for a directory) there. Needs the
    /// write right on both.
    method rename = 4 (from: in bytes, to_dir: slot, to: in bytes) -> ()
        raises [no_such_slot, empty_slot, wrong_kind, missing_rights, invalid_argument,
                no_memory, bad_address, not_found, not_directory, is_directory, not_empty,
                read_only, no_space, name_too_long, bad_name, outside, cross_mount, in_use, io,
                corrupt, too_many_links];
    /// Writes the directory's entries from `cursor` (0 for the first) into
    /// `buffer` as DirEntry records, other than `.` and `..`; returns how
    /// many it wrote (0 at the end), the bytes they take, and the cursor
    /// that continues after them. Needs the read right.
    method list = 5 (cursor: u64, buffer: out bytes) -> (count: u32, used: u64, next: u64)
        raises [no_such_slot, empty_slot, missing_rights, invalid_argument, bad_address, io,
                corrupt];
    /// What the file at `path` (`.` for this directory) is: its kind, its
    /// size and the bytes it takes on its filesystem, a number unique on
    /// its filesystem while it exists, when it was made, last changed and
    /// last read, in nanoseconds since 1970 (0 if unknown), and the number
    /// of the mount it is on, unique since boot. A symbolic link's size is
    /// its target's length. Needs the read right.
    method stat = 6 (path: in bytes, flags: PathFlags)
        -> (kind: FileKind, size: u64, allocated: u64, id: u64, created: u64, modified: u64,
            accessed: u64, mount: u64)
        raises [no_such_slot, empty_slot, missing_rights, invalid_argument, no_memory,
                bad_address, not_found, not_directory, name_too_long, bad_name, outside, io,
                corrupt, too_many_links];
    /// Mounts a filesystem of kind `filesystem` (its name, as
    /// FilesystemKind lists them) on the directory at `path`: `fat` on the
    /// block device whose file capability is in slot `source`, the others
    /// with `source` 0. A second mount on a directory stacks on the first.
    /// Needs the control right, and the read right on `source` (and the
    /// write right unless `flags` has read_only).
    method mount = 7 (path: in bytes, filesystem: in bytes, source: u32, flags: MountFlags) -> ()
        raises [no_such_slot, empty_slot, wrong_kind, missing_rights, invalid_argument,
                no_memory, bad_address, not_found, not_directory, name_too_long, bad_name,
                outside, in_use, io, corrupt, unknown_filesystem, not_block_device, too_many_links];
    /// Unmounts the filesystem whose root is at `path`, after writing what
    /// it holds in memory to its disk. Fails with in_use while anything
    /// is mounted on it or open on it. Needs the control right.
    method unmount = 8 (path: in bytes) -> ()
        raises [no_such_slot, empty_slot, missing_rights, invalid_argument, no_memory,
                bad_address, not_found, not_directory, name_too_long, bad_name, outside, in_use,
                io, corrupt, too_many_links];
    /// Writes everything the directory's filesystem holds in memory to its
    /// disk.
    method sync = 9 () -> ()
        raises [no_such_slot, empty_slot, io, corrupt];
    /// The directory's filesystem: its kind, how it is mounted, its block
    /// size, blocks and free blocks, and how many files and directories it
    /// holds at most and how many more it can take (both zero when it
    /// keeps no count, as FAT does). Needs the read right.
    method info = 10 ()
        -> (filesystem: FilesystemKind, flags: MountFlags, block_size: u32, blocks: u64, free: u64,
            files: u64, free_files: u64)
        raises [no_such_slot, empty_slot, missing_rights];
    /// Sets the times of the file or directory at `path` (`.` for this
    /// one), as radix-file(2)'s `set_times` does. Needs the write right.
    method set_times = 11 (path: in bytes, accessed: u64, modified: u64, flags: PathFlags) -> ()
        raises [no_such_slot, empty_slot, missing_rights, invalid_argument, no_memory,
                bad_address, not_found, not_directory, name_too_long, bad_name, outside,
                not_permitted, read_only, io, corrupt, too_many_links];
    /// Makes a symbolic link at `path` that points to `target`: any text
    /// of at most PATH_MAX bytes but the empty one and one with a NUL,
    /// which is not looked at until the link is followed. A filesystem
    /// that has no links, as FAT has none, refuses with not_permitted.
    /// Needs the write right.
    method make_link = 12 (path: in bytes, target: in bytes) -> ()
        raises [no_such_slot, empty_slot, missing_rights, invalid_argument, no_memory,
                bad_address, not_found, exists, not_directory, read_only, no_space,
                name_too_long, bad_name, outside, io, corrupt, not_permitted, too_many_links];
    /// Reads where the symbolic link at `path` points into `buffer`;
    /// returns the target's length, which is more than `buffer` holds if
    /// it was cut short. Fails with not_link if it is not a link. Needs
    /// the read right.
    method read_link = 13 (path: in bytes, buffer: out bytes) -> (len: u64)
        raises [no_such_slot, empty_slot, missing_rights, invalid_argument, no_memory,
                bad_address, not_found, not_directory, name_too_long, bad_name, outside, io,
                corrupt, not_link, too_many_links];
    /// Writes where `path` leads into `buffer`: the names from this
    /// directory that resolving it took, every symbolic link followed and
    /// `.` and `..` worked out, joined by `/` (`.` for this directory
    /// itself), as realpath(3) wants. Returns its length, which is more
    /// than `buffer` holds if it was cut short. Needs the read right.
    method real_path = 14 (path: in bytes, buffer: out bytes) -> (len: u64)
        raises [no_such_slot, empty_slot, missing_rights, invalid_argument, no_memory,
                bad_address, not_found, not_directory, name_too_long, bad_name, outside, io,
                corrupt, too_many_links];
    /// Names the socket in slot `socket` (radix-process(2)'s `socket`)
    /// `path`: makes a socket's name there, a file of kind socket, which
    /// `connect_socket` connects through while the socket listens. The
    /// socket keeps `name` (at most radix-file(2)'s SOCKET_NAME_MAX bytes)
    /// as its name for radix-file(2)'s `socket_name`: the path as the
    /// program gave it. A socket takes one name, before it listens or
    /// connects; the name stays until it is removed, and once the socket
    /// is gone, connecting through it fails with refused. Opening it fails
    /// with no_device. FAT has no such files (not_permitted). Needs the
    /// write right, and the write right on the socket.
    method bind_socket = 15 (path: in bytes, socket: slot, name: in bytes) -> ()
        raises [no_such_slot, empty_slot, wrong_kind, missing_rights, invalid_argument,
                no_memory, bad_address, not_found, exists, not_directory, read_only, no_space,
                name_too_long, bad_name, outside, io, corrupt, not_permitted, too_many_links,
                not_socket, busy];
    /// Connects the socket in slot `socket`, which must be neither
    /// connected nor listening, to the socket listening at the name
    /// `path`: the connection waits there until radix-file(2)'s `accept`
    /// takes it, and the socket can send and receive at once. While as
    /// many connections wait as the listening socket allows, it waits
    /// for room, or fails with would_block if the socket's description
    /// is non_blocking. A name of a socket that does not listen, or is
    /// gone, and any other file, fail with refused. Needs the write right,
    /// and the write right on the socket.
    method connect_socket = 16 (path: in bytes, socket: slot) -> ()
        raises [no_such_slot, empty_slot, wrong_kind, missing_rights, invalid_argument,
                no_memory, bad_address, not_found, not_directory, name_too_long, bad_name,
                outside, io, corrupt, too_many_links, not_socket, refused, connected, busy,
                would_block, interrupted];
}
