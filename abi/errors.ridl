//! The errors of the kernel's system calls and interfaces.
//!
//! A system call returns a status word: 0 for success, otherwise the
//! error's domain in bits 16 to 31, its code in bits 0 to 15 and a detail
//! in bits 32 to 63 (which argument was wrong, which rights were missing).
//! Every error maps to the POSIX errno value given after `=>`, which the C
//! library returns.

module errors;

/// Errors of the kernel's own system calls and object interfaces.
errors kernel = 1 {
    /// The system call number is not one of the twelve.
    no_such_syscall = 1 => ENOSYS;
    /// The slot number is beyond the end of the caller's capability space.
    no_such_slot = 2 => EBADF;
    /// The slot holds no capability.
    empty_slot = 3 => EBADF;
    /// The capability designates another kind of object than the call
    /// needs. The detail is the kind it designates.
    wrong_kind = 4 => EBADF;
    /// The capability lacks rights the call needs. The detail holds the
    /// missing rights.
    missing_rights = 5 => EACCES;
    /// The capability is sealed: only the holder of its key can use it
    /// once it is unsealed.
    sealed = 6 => EPERM;
    /// The destination slot already holds a capability.
    occupied = 7 => EEXIST;
    /// An argument is outside what the call accepts. The detail is the
    /// argument's position, counting from 0.
    invalid_argument = 8 => EINVAL;
    /// The kernel ran out of memory for the call.
    no_memory = 9 => ENOMEM;
    /// A buffer the call reads or writes is not mapped for that access.
    bad_address = 10 => EFAULT;
    /// The call would have to wait, and the caller asked it not to.
    would_block = 11 => EAGAIN;
    /// A ring's completion queue has no room for another completion, or
    /// the process is traced already (radix-process(2)'s `trace`).
    busy = 12 => EBUSY;
    /// The receiver's receive window has no room for the capabilities in
    /// the message.
    no_room = 13 => ENOSPC;
    /// The object is gone: its last capability was deleted, or the thread
    /// at the other end of the call exited.
    gone = 14 => EPIPE;
    /// The thread was asked to stop while it waited, or a signal came
    /// for it (radix-signal(2)).
    interrupted = 15 => EINTR;
    /// There is no caller to reply to.
    no_caller = 16 => ENOTCONN;
    /// The object does not answer this method, or the label is reserved.
    no_such_method = 17 => EOPNOTSUPP;
    /// The capability, or one it was derived from, is being revoked.
    revoking = 18 => EBUSY;
    /// A derivation would be deeper than the kernel allows.
    too_deep = 19 => EMLINK;
    /// The memory object has no room left for the objects asked for.
    exhausted = 20 => ENOMEM;
    /// A range reaches outside what the capability or object covers.
    out_of_range = 21 => ERANGE;
    /// Something is already mapped at the address.
    already_mapped = 22 => EEXIST;
    /// Nothing is mapped at the address.
    not_mapped = 23 => ENXIO;
    /// The wait ended because its timeout passed.
    timed_out = 24 => ETIMEDOUT;
    /// The key is not the endpoint the capability was sealed with.
    wrong_key = 25 => EPERM;
    /// The badge cannot be given: this kind takes no badge, the capability
    /// already has one, or the badge is 0.
    bad_badge = 26 => EINVAL;
    /// No process has the number given, or none of those it stands for
    /// (a process group, a session) exists.
    no_such_process = 27 => ESRCH;
    /// The caller has no child the call could wait for.
    no_child = 28 => ECHILD;
    /// The caller may not do this to that process: it is neither the
    /// caller, nor one of its descendants, nor in its session.
    not_permitted = 29 => EPERM;
    /// The file is not a terminal, or not the caller's controlling
    /// terminal.
    not_terminal = 30 => ENOTTY;
    /// The file is not a program the kernel can run: not an ELF
    /// executable for this machine, nor a script that names one.
    not_executable = 31 => ENOEXEC;
    /// A program's arguments and environment are larger than the kernel
    /// takes.
    arguments_too_long = 32 => E2BIG;
    /// The file has no offset to move: it is a pipe or a terminal.
    not_seekable = 33 => ESPIPE;
    /// The process has run `exec` since its parent forked it, so the
    /// parent can no longer move it to another process group.
    execed = 34 => EACCES;
    /// A resource limit does not allow it: a nice level below the one
    /// RLIMIT_NICE allows (radix-process(2)'s `priority`).
    over_limit = 35 => EACCES;
    /// The file is not a socket: `send`, `receive` and `shutdown` are for
    /// sockets alone.
    not_socket = 36 => ENOTSOCK;
    /// No socket listens at that name: the name leads to no socket, or to
    /// one that does not listen or is gone (radix-directory(2)'s
    /// `connect_socket`).
    refused = 37 => ECONNREFUSED;
    /// The socket is connected already.
    connected = 38 => EISCONN;
    /// The socket is not connected.
    not_connected = 39 => ENOTCONN;
    /// The call does not take what it was given: a socket among the
    /// files sent with radix-file(2)'s `send_files`.
    not_supported = 40 => EOPNOTSUPP;
    /// Too many files are on their way through the socket already, sent
    /// and not yet received (radix-file(2)'s `send_files`).
    too_many = 41 => ETOOMANYREFS;
    /// Another socket is bound to the address and port already
    /// (radix-file(2)'s `bind_address`), or every port the kernel picks
    /// from is taken.
    address_in_use = 42 => EADDRINUSE;
    /// The address is not one of the machine's own, so no socket can be
    /// bound to it.
    address_not_available = 43 => EADDRNOTAVAIL;
    /// The other end of the connection reset it.
    reset = 44 => ECONNRESET;
    /// No interface has a route to the address.
    unreachable = 45 => ENETUNREACH;
    /// The connection is being made, and the socket's description is
    /// non_blocking: `poll` finds it writable once it is made or failed,
    /// and radix-file(2)'s `socket_option` error tells which.
    in_progress = 46 => EINPROGRESS;
    /// A connection is being made already.
    already = 47 => EALREADY;
    /// The datagram is too long to send in one piece.
    message_too_long = 48 => EMSGSIZE;
    /// The kernel has no room for another socket on the interface.
    no_buffers = 49 => ENOBUFS;
    /// The datagram is to a broadcast address, from a socket that did
    /// not say it sends to every host (radix-file(2)'s broadcast option,
    /// SO_BROADCAST).
    broadcast = 50 => EACCES;
}

/// Errors of files and directories (radix-directory(2), radix-file(2)).
errors file = 2 {
    /// No file has that name.
    not_found = 1 => ENOENT;
    /// A file has that name already.
    exists = 2 => EEXIST;
    /// A component of the path is not a directory.
    not_directory = 3 => ENOTDIR;
    /// The file is a directory.
    is_directory = 4 => EISDIR;
    /// The directory is not empty.
    not_empty = 5 => ENOTEMPTY;
    /// The filesystem does not allow changes.
    read_only = 6 => EROFS;
    /// The filesystem is full.
    no_space = 7 => ENOSPC;
    /// A name is longer than NAME_MAX bytes, or the path than PATH_MAX.
    name_too_long = 8 => ENAMETOOLONG;
    /// A name is empty, `.` or `..` where a file is meant, holds a NUL or
    /// is not UTF-8, or is one the filesystem cannot store.
    bad_name = 9 => EINVAL;
    /// The path leaves the directory it is resolved beneath: it starts
    /// with `/`, or its `..` climbs above it.
    outside = 10 => EXDEV;
    /// The operation would move a file between filesystems.
    cross_mount = 11 => EXDEV;
    /// The file is in use: a mount point, or a filesystem with files open.
    in_use = 12 => EBUSY;
    /// The disk failed to read or write.
    io = 13 => EIO;
    /// The filesystem's structures on the disk are damaged.
    corrupt = 14 => EUCLEAN;
    /// The file would grow past the largest size the filesystem allows.
    too_big = 15 => EFBIG;
    /// No filesystem of that kind exists, or it does not recognise the
    /// disk.
    unknown_filesystem = 16 => ENODEV;
    /// A mount needs a block device and was given another file.
    not_block_device = 17 => ENOTBLK;
    /// The device the file stands for is not there: `/devices/tty` opened by
    /// a process whose session has no controlling terminal.
    no_device = 18 => ENXIO;
    /// Waiting for a file lock would never end: its holder waits, in a
    /// chain, for a lock the caller's process holds (radix-file(2)'s
    /// `lock`).
    deadlock = 19 => EDEADLK;
    /// Resolving a path met more than 40 symbolic links, or one where
    /// the call said not to follow it (radix-directory(2)).
    too_many_links = 20 => ELOOP;
    /// The file is not a symbolic link.
    not_link = 21 => EINVAL;
    /// The file has as many names as its filesystem keeps for one
    /// (radix-directory(2)'s `link`; 65535 on Btrfs).
    too_many_names = 22 => EMLINK;
    /// The change would take its subvolume's quota group past its limit
    /// (Btrfs's simple quotas, radix-directory(2)'s `limit_qgroup`).
    quota_exceeded = 23 => EDQUOT;
    /// The file's owner, group and mode do not let the name the
    /// capability acts for do this: the second gate (radix-directory(2)).
    denied = 24 => EACCES;
}
