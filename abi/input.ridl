//! Keyboards (Phase 9, ADR 0097): the keys pressed on them, as events.
//!
//! _/dev/kbd_ (radix-files(7)) is every keyboard of the machine as one:
//! since Phase 9 the built-in PS/2 one behind the i8042 controller, which
//! is QEMU's default keyboard and how laptops such as the reference Dell
//! connect theirs, and from Phase 11 USB keyboards too. A read returns
//! whole Event structures, as many as fit, the oldest the reader has not
//! read: each description keeps its own place, so two readers each see
//! every event, and a new description starts with the events after it was
//! opened, never the keys typed before. A read waits for an event unless
//! the file is non-blocking, and fails with invalid_argument if the buffer
//! cannot hold one; one that falls more than EVENTS_KEPT events behind
//! fails with gone once, then goes on with the oldest kept. `poll` finds
//! it readable while an event waits.
//!
//! The kernel turns no key into text: consoled(8) does, with its key map,
//! and handles the virtual terminal keys (Alt+F1 to Alt+F6). Key codes are
//! Linux's (<linux/input-event-codes.h>), so that key maps and programs
//! made for Linux's evdev read them as they would there. A key held down
//! repeats, as the keyboard sends it again: the events after the first
//! are REPEATED.

module input;

/// How many events _/dev/kbd_ keeps for readers that fall behind.
const EVENTS_KEPT: u32 = 512;

/// The key went up.
const RELEASED: u16 = 0;
/// The key went down.
const PRESSED: u16 = 1;
/// The key is held down, and the keyboard repeats it.
const REPEATED: u16 = 2;

/// radix-file(2)'s `control` request on _/dev/kbd_ that lights the
/// keyboard's lock lights: `argument` holds LED_* bits, and the lights
/// whose bits are clear go out. Needs the write right.
const SET_LEDS: u32 = 0x4b420001;
/// The Scroll Lock light.
const LED_SCROLL_LOCK: u32 = 1;
/// The Num Lock light.
const LED_NUM_LOCK: u32 = 2;
/// The Caps Lock light.
const LED_CAPS_LOCK: u32 = 4;

/// One key going down, repeating or going up.
struct Event {
    /// When: nanoseconds since boot, on the clock radix-process(2)'s
    /// `clock` calls monotonic.
    time_ns: u64;
    /// Which key: a KEY_* code.
    code: u16;
    /// What it did: RELEASED, PRESSED or REPEATED.
    value: u16;
    /// Always 0.
    reserved: u32;
}

/// Escape.
const KEY_ESC: u16 = 1;
/// The 1 key; 2 to 9 follow it, then 0.
const KEY_1: u16 = 2;
/// The 2 key.
const KEY_2: u16 = 3;
/// The 3 key.
const KEY_3: u16 = 4;
/// The 4 key.
const KEY_4: u16 = 5;
