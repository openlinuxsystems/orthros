//! Keyboards and pointers (Phase 9, ADR 0097; Phase 11a, ADR 0148): the
//! keys pressed on them, and how pointers move, as events.
//!
//! _/devices/kbd_ (radix-files(7)) is every keyboard of the machine as one:
//! the built-in PS/2 one behind the i8042 controller, which is QEMU's
//! default keyboard and how laptops such as the reference Dell connect
//! theirs, and since Phase 11a USB keyboards, with their media keys. A read
//! returns whole Event structures, as many as fit, the oldest the reader
//! has not read: each description keeps its own place, so two readers each
//! see every event, and a new description starts with the events after it
//! was opened, never the keys typed before. A read waits for an event
//! unless the file is non-blocking, and fails with invalid_argument if the
//! buffer cannot hold one; one that falls more than EVENTS_KEPT events
//! behind fails with gone once, then goes on with the oldest kept. `poll`
//! finds it readable while an event waits.
//!
//! The kernel turns no key into text: consoled(8) does, with its key map,
//! and handles the virtual terminal keys (Alt+F1 to Alt+F6). Key codes are
//! Linux's (<linux/input-event-codes.h>), so that key maps and programs
//! made for Linux's evdev read them as they would there. A key held down
//! repeats: the events after the first are REPEATED. A PS/2 keyboard
//! repeats a key itself; a USB keyboard does not, so the kernel repeats the
//! last key one pressed while it is held, 250 ms after it went down and
//! then every 33 ms, as Linux does.
//!
//! _/devices/mouse_ is every pointer as one: USB mice, and tablets such as
//! QEMU's `usb-tablet`, which say where they point rather than how far they
//! moved. It is read as _/devices/kbd_ is, in whole Motion structures, each
//! what one report of one pointer changed; a reader that falls more than
//! MOTIONS_KEPT behind fails with gone once.

module input;

/// How many events _/devices/kbd_ keeps for readers that fall behind.
const EVENTS_KEPT: u32 = 512;

/// The key went up.
const RELEASED: u16 = 0;
/// The key went down.
const PRESSED: u16 = 1;
/// The key is held down, and the keyboard repeats it.
const REPEATED: u16 = 2;

/// radix-file(2)'s `control` request on _/devices/kbd_ that lights the
/// lock lights of every keyboard: `argument` holds LED_* bits, and the lights
/// whose bits are clear go out. Needs the write right.
const SET_LEDS: u32 = 0x4b420001;
/// The Scroll Lock light.
const LED_SCROLL_LOCK: u32 = 1;
/// The Num Lock light.
const LED_NUM_LOCK: u32 = 2;
/// The Caps Lock light.
const LED_CAPS_LOCK: u32 = 4;

/// One key going down, repeating or going up.
struct Event {
    /// When: nanoseconds since boot, on the clock radix-process(2)'s
    /// `clock` calls monotonic.
    time_ns: u64;
    /// Which key: a KEY_* code.
    code: u16;
    /// What it did: RELEASED, PRESSED or REPEATED.
    value: u16;
    /// Always 0.
    reserved: u32;
}

/// How many motions _/devices/mouse_ keeps for readers that fall behind.
const MOTIONS_KEPT: u32 = 512;

/// The left button, in Motion's `buttons`.
const BUTTON_LEFT: u32 = 1;
/// The right button.
const BUTTON_RIGHT: u32 = 2;
/// The middle button, or the wheel pressed.
const BUTTON_MIDDLE: u32 = 4;
/// The side button nearer the user: back, in a browser.
const BUTTON_SIDE: u32 = 8;
/// The side button farther from the user: forward.
const BUTTON_EXTRA: u32 = 16;

/// The most of Motion's `x` and `y`.
const POSITION_MAX: u32 = 65535;

/// Motion's `flags`: `x` and `y` say where the pointer points.
const MOTION_ABSOLUTE: u32 = 1;

/// What one report of a pointer changed.
struct Motion {
    /// When: nanoseconds since boot, as Event's.
    time_ns: u64;
    /// How far it moved, in the device's counts: right is more.
    dx: i32;
    /// Down is more.
    dy: i32;
    /// The wheel's detents: away from the user is more.
    wheel: i32;
    /// The horizontal wheel's: right is more.
    pan: i32;
    /// Where it points, with MOTION_ABSOLUTE: from 0 at the screen's left
    /// edge to POSITION_MAX at its right.
    x: u32;
    /// From 0 at its top to POSITION_MAX at its bottom.
    y: u32;
    /// The buttons down after it: BUTTON_* bits, then a bit for each
    /// further button.
    buttons: u32;
    /// MOTION_ABSOLUTE, or 0.
    flags: u32;
}

