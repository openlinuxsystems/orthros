//! Names (Phase 13, ADR 0214): who a process or a capability acts for.
//!
//! A name is a user number, a group number and up to GROUPS_MAX more
//! groups: a user who signs in (from 1000), a service's account, or 0, the
//! admin label shown as root. It grants nothing by itself. Every process
//! acts for one, which POSIX's getuid(2) and its kin give (radix-process(2)'s
//! `identity`), and so does every file and directory capability: the
//! second gate checks the owners, groups and modes of the files it meets
//! against it, and the files made through it belong to it
//! (radix-directory(2)).
//!
//! Names pass on and do not change: a process `create` or `fork` makes acts
//! for its maker's, and `exec` keeps it; a file or directory opened through
//! a directory acts for that directory's, and a pipe, socket or terminal a
//! process makes for the process's. Only a holder of the names capability
//! gives another name, with the two methods below. The kernel gives Spark
//! the one capability to it, acting for root with its root's bypass
//! right (spark(8)); from Phase 13b.5 Spark gives a copy to authd, which
//! signs users in.

module names;

/// The most groups a name has beyond its own.
const GROUPS_MAX: u32 = 32;

/// The authority to give names. Every method needs the control right.
interface names = 0x0011 version 1 {
    kind = names;
    /// Has the process in slot `process`, which `create` made and which
    /// has not started, act for user `user`, group `group`, and the groups
    /// in `groups`, as u32s (GROUPS_MAX at most, or invalid_argument).
    /// One that has started fails with invalid_argument. Needs the control
    /// right on the process.
    method name_process = 1 (process: slot, user: u32, group: u32, groups: in bytes) -> ()
        raises [no_such_slot, empty_slot, wrong_kind, missing_rights, invalid_argument,
                bad_address];
    /// Puts in slot `to` a capability to the directory in slot
    /// `directory`, with its rights, that acts for user `user`, group
    /// `group` and the groups in `groups`, as `name_process` takes them.
    /// What is opened or made through it acts for that name and belongs to
    /// it.
    method stamp = 2 (directory: slot, to: slot, user: u32, group: u32, groups: in bytes) -> ()
        raises [no_such_slot, empty_slot, wrong_kind, missing_rights, occupied, invalid_argument,
                bad_address, no_memory];
}
