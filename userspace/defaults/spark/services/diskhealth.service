#
# Disk health: diskhealth(8) reads each disk's SMART record or NVMe health
# log at boot and every half hour, and writes a line to the kernel log
# when a disk's verdict changes, as smartd(8) does on Linux.

description = Disk health
program = /system/commands/diskhealth
arguments = --watch
# After the disks are mounted and the consoles are up.
order = 50
restart = on-failure
