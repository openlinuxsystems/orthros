#
# Notifications: notifyd(8) takes them from notify-send(1) and other
# programs and passes them to consoled(8), which shows them on the
# screen's bottom line (ADR 0212).

description = Notifications
program = /system/commands/notifyd
# Before consoled, so that the consoles find it when they start.
order = 7
restart = always
memory = 16M
