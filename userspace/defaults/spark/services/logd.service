#
# The system's log: logd(8) keeps every record of the kernel log, the
# services' lines among them, in /system/state/log as lines of JSON, one
# file a day, and answers log(1) and journalctl(1) (ADR 0210).

description = System log
program = /system/commands/logd
# First, so that it reads the kernel log before its ring wraps.
order = 5
restart = always
memory = 64M
