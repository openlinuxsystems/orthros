#
# The spark-stop boot test's service that ignores SIGTERM: Spark stops
# its domain 5 s after `service stubborn restart` or `stop`.

description = Ignores SIGTERM
program = /system/bin/nukesh
arguments = -c "trap '' TERM; echo up; while :; do sleep 1; done"
restart = always
