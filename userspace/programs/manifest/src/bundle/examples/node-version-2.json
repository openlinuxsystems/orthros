{
  "manifest_version": 2,
  "id": "org.nodejs.node",
  "name": "Node.js 22",
  "version": "22.11.0",
  "line": "22",
  "summary": "JavaScript runtime",
  "publisher": { "name": "Dukovo catalog" },
  "license": "MIT",
  "requires_os": "1.3",
  "architectures": ["x86_64"],
  "runtime": "linux",
  "programs": {
    "node": { "path": { "x86_64": "bin/node" } },
    "npm": { "path": { "x86_64": "bin/npm" } },
    "npx": { "path": { "x86_64": "bin/npx" } }
  },
  "commands": [
    { "name": "node", "program": "node", "runs_with": "your-access" },
    { "name": "npm", "program": "npm", "runs_with": "your-access" },
    { "name": "npx", "program": "npx", "runs_with": "your-access" }
  ],
  "permissions": {
    "memory.jit": { "need": "required", "why": "V8 compiles JavaScript to machine code as it runs" }
  },
  "add_ons": { "tool": "npm", "commands": "bin" },
  "data": { "cache": true }
}
