{
  "manifest_version": 2,
  "id": "org.example.photos",
  "name": "Photos",
  "version": "1.0.0",
  "summary": "Your photo library",
  "publisher": { "name": "Example Ltd" },
  "license": "MIT",
  "requires_os": "1.5",
  "architectures": ["x86_64", "aarch64"],
  "programs": { "photos": { "path": { "x86_64": "bin/x86_64/photos", "aarch64": "bin/aarch64/photos" } } },
  "permissions": {
    "display": { "need": "required" },
    "files.folder": { "folders": { "pictures": "read-write" }, "need": "required", "why": "Shows and organizes your photo library" },
    "devices.camera": { "need": "optional", "why": "Imports from a connected camera" }
  },
  "entries": {
    "launchers": [ {
      "name": { "en": "Photos", "de": "Fotos" },
      "icon": "resources/photos.svg",
      "category": "graphics",
      "keywords": ["pictures", "images", "albums"],
      "tasks": ["import-from-camera"]
    } ],
    "opens": [ { "types": ["image/jpeg", "image/png", "image/avif"], "role": "edit" } ],
    "file_actions": [ { "action": "add-to-album", "types": ["image/*"] } ]
  },
  "actions": [
    { "id": "import-from-camera", "label": { "en": "Import from camera" }, "risk": "change" },
    { "id": "add-to-album", "label": { "en": "Add to album" }, "takes": "files", "risk": "change" }
  ],
  "data": { "settings": true, "data": true, "cache": true }
}
