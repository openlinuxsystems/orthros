#
# al: Albanian, made by generate.py from xkeyboard-config
# 2.48's `al` layout (keymaps/COPYING-xkeyboard-config).
# keymap(5) describes the format: a key's Linux name, then what it types
# alone, with Shift, with AltGr and with Shift and AltGr.

name = Albanian
rightalt = altgr

1           1        !        ~        dead:tilde
2           2        "        dead:caron ⅛
3           3        #        dead:circumflex £
4           4        $        dead:breve $
5           5        %        dead:abovering ⅜
6           6        ^        dead:ogonek ⅝
7           7        &        `        dead:grave
8           8        *        dead:abovedot ™
9           9        (        dead:acute ±
0           0        )        dead:doubleacute °
minus       U+002D   _        dead:diaeresis ¿
equal       =        +        dead:cedilla dead:ogonek
q           q        Q        \        Ω
w           w        W        |        Σ
e           e        E        €        €
r           r        R        ¶        ®
t           t        T        ŧ        Ŧ
y           z        Z        ←        ¥
u           u        U        ↓        ↑
i           i        I        →        ı
o           o        O        ø        Ø
p           p        P        þ        Þ
leftbrace   ç        Ç        ÷        dead:abovering
rightbrace  @        '        ×        dead:macron
a           a        A        æ        Æ
s           s        S        đ        §
d           d        D        Đ        Ð
f           f        F        [        ª
g           g        G        ]        Ŋ
h           h        H        ħ        Ħ
j           j        J        dead:hook dead:horn
k           k        K        ł        &
l           l        L        ł        Ł
semicolon   ë        Ë        $        dead:doubleacute
apostrophe  [        {        ß        dead:caron
grave       \        |        ¬        ¬
backslash   ]        }        ¤        dead:breve
z           y        Y        «        <
x           x        X        »        >
c           c        C        ¢        ©
v           v        V        @        `
b           b        B        {        '
n           n        N        }        ´
m           m        M        §        º
comma       ,        ;        <        ×
dot         .        :        >        ÷
slash       /        ?        dead:belowdot dead:abovedot
space       U+0020
102nd       <        >        |        ¦
kpdot       .
