# hu: Hungarian, made by generate.py from xkeyboard-config
# 2.48's `hu` layout (keymaps/COPYING-xkeyboard-config).
# keymap(5) describes the format: a key's Linux name, then what it types
# alone, with Shift, with AltGr and with Shift and AltGr.

name = Hungarian
rightalt = altgr

1           1        '        ~        dead:tilde
2           2        "        dead:caron ˇ
3           3        +        ^        dead:circumflex
4           4        !        dead:breve ˘
5           5        %        dead:abovering °
6           6        /        dead:ogonek ˛
7           7        =        `        dead:grave
8           8        (        dead:abovedot ˙
9           9        )        dead:acute ´
0           ö        Ö        dead:doubleacute ˝
minus       ü        Ü        dead:diaeresis ¨
equal       ó        Ó        dead:cedilla ¸
q           q        Q        \        Ω
w           w        W        |        §
e           e        E        Ä        E
r           r        R        ¶        ®
t           t        T        ŧ        Ŧ
y           z        Z        –        ¥
