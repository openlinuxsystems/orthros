#
# us-intl: English (US, intl., with dead keys), made by generate.py from xkeyboard-config
# 2.48's `us(intl)` layout (keymaps/COPYING-xkeyboard-config).
# keymap(5) describes the format: a key's Linux name, then what it types
# alone, with Shift, with AltGr and with Shift and AltGr.

name = English (US, intl., with dead keys)
rightalt = altgr

