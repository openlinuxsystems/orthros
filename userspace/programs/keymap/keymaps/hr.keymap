#
# hr: Croatian, made by generate.py from xkeyboard-config
# 2.48's `hr` layout (keymaps/COPYING-xkeyboard-config).
# keymap(5) describes the format: a key's Linux name, then what it types
# alone, with Shift, with AltGr and with Shift and AltGr.

name = Croatian
rightalt = altgr

1           1        !        ~        dead:tilde
2           2        "        dead:caron ˇ
3           3        #        ^        dead:circumflex
4           4        $        dead:breve ˘
5           5        %        °        dead:abovering
6           6        &        dead:ogonek ˛
7           7        /        `        dead:grave
8           8        (        dead:abovedot ˙
9           9        )        dead:acute '
0           0        =        dead:doubleacute ˝
minus       '        ?        dead:diaeresis ¨
