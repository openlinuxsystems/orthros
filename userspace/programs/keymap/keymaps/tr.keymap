# tr: Turkish, made by generate.py from xkeyboard-config
# 2.48's `tr` layout (keymaps/COPYING-xkeyboard-config).
# keymap(5) describes the format: a key's Linux name, then what it types
# alone, with Shift, with AltGr and with Shift and AltGr.

name = Turkish
rightalt = altgr

