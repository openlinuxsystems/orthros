# cz: Czech, made by generate.py from xkeyboard-config
# 2.48's `cz` layout (keymaps/COPYING-xkeyboard-config).
# keymap(5) describes the format: a key's Linux name, then what it types
# alone, with Shift, with AltGr and with Shift and AltGr.

name = Czech
rightalt = altgr

1           +        1        !        dead:tilde
2           ě        2        @        dead:caron
3           š        3        #        dead:circumflex
4           č        4        $        dead:breve
