+        assert_eq!(
+            s.sacked,
+            [
+                Some((LOCAL_SEQ + 1 + 3, LOCAL_SEQ + 1 + 6)),
+                Some((LOCAL_SEQ + 1 + 9, LOCAL_SEQ + 1 + 15)),
+                None,
+                None
+            ]
