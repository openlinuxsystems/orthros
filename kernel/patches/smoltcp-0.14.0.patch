+#[cfg(all(test, feature = "socket-udp", feature = "socket-tcp"))]
+mod test {
+    use super::*;
+    use crate::socket::{tcp, udp};
+
+    fn udp_socket() -> udp::Socket<'static> {
+        udp::Socket::new(
+            udp::PacketBuffer::new(vec![], vec![]),
+            udp::PacketBuffer::new(vec![], vec![]),
+        )
+    }
+
+    #[test]
+    fn test_try_add_get_remove() {
+        let mut storage = [SocketStorage::EMPTY];
+        let mut set = SocketSet::new(&mut storage[..]);
+        let handle = set.try_add(udp_socket()).unwrap();
+        assert!(set.try_add(udp_socket()).is_err());
+        assert!(set.try_get::<udp::Socket>(handle).is_some());
+        assert!(set.try_get_mut::<udp::Socket>(handle).is_some());
+        assert!(set.try_get::<tcp::Socket>(handle).is_none());
+        assert!(set.try_get_mut::<udp::Socket>(SocketHandle(1)).is_none());
+        assert!(set.try_remove(handle).is_some());
+        assert!(set.try_remove(handle).is_none());
+        assert!(set.try_get::<udp::Socket>(handle).is_none());
+        assert!(set.try_add(udp_socket()).is_ok());
+    }
+
+    #[test]
+    fn test_iterates_only_up_to_the_last_socket() {
+        let mut storage = [SocketStorage::EMPTY, SocketStorage::EMPTY, SocketStorage::EMPTY];
+        let mut set = SocketSet::new(&mut storage[..]);
+        assert_eq!(set.used, 0);
+        let first = set.add(udp_socket());
+        let second = set.add(udp_socket());
+        let third = set.add(udp_socket());
+        assert_eq!(set.used, 3);
+        set.remove(second);
+        assert_eq!(set.used, 3, "a hole before the last socket stays");
+        assert_eq!(set.iter().count(), 2);
+        assert!(set.try_remove(third).is_some());
+        assert_eq!(set.used, 1, "the hole goes with the socket after it");
+        assert_eq!(set.iter().map(|(handle, _)| handle).collect::<Vec<_>>(), [first]);
+        assert_eq!(set.add(udp_socket()), second);
+        assert_eq!(set.used, 2);
+        set.remove(first);
+        set.remove(second);
+        assert_eq!(set.used, 0);
+        assert_eq!(set.iter().count(), 0);
     }
 }
