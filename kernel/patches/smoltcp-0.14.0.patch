+    /// Give up the socket, and return its receive and transmit buffers,
+    /// so that memory lent to them can be taken back.
+    pub fn into_buffers(self) -> (SocketBuffer<'a>, SocketBuffer<'a>) {
+        (self.rx_buffer, self.tx_buffer)
+    }
+
+    // Passing octets across. A connection whose other end is a socket of
+    // the same interface can pass its octets straight into that socket's
+    // receive buffer, with no segment between them, as Solaris's TCP
+    // fusion does. Each end counts them as a segment sent, received and
+    // acknowledged at once, so that its sequence numbers, windows and
+    // timers are as they would have been, and segments can go between the
+    // two again at any time. Whoever owns both sockets pairs them, and
+    // passes octets across only when no segment between them is on its
+    // way.
+
+    /// The sequence number of the next octet this socket sends, if it can
+    /// pass octets straight across to the other end: its transmit half is
+    /// open, and no octet waits to be sent or acknowledged.
+    pub fn next_across(&self) -> Option<TcpSeqNumber> {
+        let idle = self.tx_buffer.is_empty()
+            && self.remote_last_seq == self.local_seq_no
+            && !self.pending_fast_retransmit;
+        (self.may_send() && idle).then_some(self.local_seq_no)
+    }
+
+    /// How many octets this socket can take straight from the other end,
+    /// which sends from `seq`: `None` unless its receive half is open,
+    /// `seq` is the next octet it expects, and it has acknowledged every
+    /// octet it received, none out of order.
+    pub fn room_across(&self, seq: TcpSeqNumber) -> Option<usize> {
+        let open = matches!(
+            self.state,
+            State::Established | State::FinWait1 | State::FinWait2
+        ) && !self.rx_fin_received;
+        let next = self.remote_seq_no + self.rx_buffer.len();
+        let in_step =
+            next == seq && self.remote_last_ack == Some(next) && self.assembler.is_empty();
+        (open && in_step).then(|| self.rx_buffer.window())
+    }
+
+    /// Takes octets straight from the other end at `now`, once
+    /// `room_across` has said it can: `write` writes them into the room at
+    /// the end of the receive buffer, and returns how many it wrote and
+    /// what to return. They are acknowledged at once. Returns what `write`
+    /// returned, how many octets came, and the window this socket offers
+    /// now, as a segment's window field, for the other end's
+    /// `sent_across`.
+    pub fn receive_across<F, R>(&mut self, now: Instant, write: F) -> (R, usize, u16)
+    where
+        F: FnOnce(&mut [u8]) -> (usize, R),
+    {
+        let (size, result) = self.rx_buffer.enqueue_many_with(write);
+        if size > 0 {
+            self.remote_last_ack = Some(self.remote_seq_no + self.rx_buffer.len());
+            self.remote_last_win = self.scaled_window();
+            self.ack_delay_timer = AckDelayTimer::Idle;
+            self.heard_across(now);
+        }
+        (result, size, self.scaled_window())
+    }
+
+    /// Counts `size` octets as passed straight across to the other end at
+    /// `now` and acknowledged by it, which offers `window` now (a
+    /// segment's window field): what its `receive_across` returned.
+    pub fn sent_across(&mut self, size: usize, window: u16, now: Instant) {
+        self.local_seq_no += size;
+        self.remote_last_seq = self.local_seq_no;
+        self.local_rx_last_ack = Some(self.local_seq_no);
+        self.local_rx_dup_acks = 0;
+        self.take_window_across(window, now);
+    }
+
+    /// The window this socket offers, as a segment's window field, and the
+    /// acknowledgement number it goes with, if the other end can be told of
+    /// it straight: its receive half is open, and it has acknowledged every
+    /// octet it received, none out of order.
+    pub fn window_across(&self) -> Option<(TcpSeqNumber, u16)> {
+        let open = matches!(
+            self.state,
+            State::Established | State::FinWait1 | State::FinWait2
+        );
+        let next = self.remote_seq_no + self.rx_buffer.len();
+        let acked = self.remote_last_ack == Some(next) && self.assembler.is_empty();
+        (open && acked).then(|| (next, self.scaled_window()))
+    }
+
+    /// Counts `window`, which `window_across` gave, as told to the other
+    /// end.
+    pub fn told_window_across(&mut self, window: u16) {
+        self.remote_last_win = window;
+    }
+
+    /// Takes `window`, a segment's window field, as the window the other
+    /// end offers, told straight at `now` with the acknowledgement number
+    /// `ack`: false, and nothing changes, unless the connection is
+    /// synchronized and `ack` is the first octet of this socket's not yet
+    /// acknowledged.
+    pub fn heard_window_across(&mut self, ack: TcpSeqNumber, window: u16, now: Instant) -> bool {
+        let synchronized = !matches!(
+            self.state,
+            State::Closed | State::Listen | State::SynSent | State::SynReceived | State::TimeWait
+        );
+        if !synchronized || ack != self.local_seq_no {
+            return false;
+        }
+        self.take_window_across(window, now);
+        true
+    }
+
+    /// Takes `window` as the window the other end offers now, as an
+    /// acknowledgement from it at `now` would.
+    fn take_window_across(&mut self, window: u16, now: Instant) {
+        let window = (window as usize) << self.remote_win_scale.unwrap_or(0);
+        self.remote_win_len = window;
+        self.congestion_controller
+            .inner_mut()
+            .set_remote_window(window);
+        if window == 0 && !self.tx_buffer.is_empty() && self.timer.is_idle() {
+            let delay = self.rtte.retransmission_timeout();
+            self.timer.set_for_zero_window_probe(now, delay);
+        }
+        if window != 0 && self.timer.is_zero_window_probe() {
+            self.timer.set_for_idle(now, self.keep_alive);
+        }
+        self.heard_across(now);
+    }
+
+    /// Counts the other end as heard from at `now`, as a segment from it
+    /// would.
+    fn heard_across(&mut self, now: Instant) {
+        self.remote_last_ts = Some(now);
+        if self.timer.is_idle() {
+            self.timer.set_for_idle(now, self.keep_alive);
+        }
+    }
