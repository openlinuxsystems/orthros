+    #[test]
+    fn test_time_wait_gives_way_to_a_new_connection() {
+        let syn = |seq_number, timestamp| TcpRepr {
+            control: TcpControl::Syn,
+            seq_number,
+            ack_number: None,
+            timestamp,
+            ..SEND_TEMPL
+        };
+
+        // A SYN numbered past what the connection received opens a new one: the old closes,
+        // with no reset, and a listening socket is left to take it.
+        let mut s = socket_time_wait(false);
+        assert!(!takes_syn(&mut s, &syn(REMOTE_SEQ + 1 + 1 + 1000, None)));
+        assert_eq!(s.state, State::Closed);
+        recv_nothing!(s);
+
+        // One numbered before is an old duplicate, the connection's own.
+        let mut s = socket_time_wait(false);
+        assert!(takes_syn(&mut s, &syn(REMOTE_SEQ, None)));
+        assert_eq!(s.state, State::TimeWait);
+
+        // So is one with an older timestamp, while one with a newer opens a new connection.
+        let mut s = socket_time_wait(false);
+        s.set_tsval_generator(Some(|| 1));
+        s.last_remote_tsval = 100;
+        s.last_remote_tsval_at = Some(Instant::from_millis(0));
+        let old = Some(TcpTimestampRepr::new(99, 0));
+        assert!(takes_syn(&mut s, &syn(REMOTE_SEQ, old)));
+        assert_eq!(s.state, State::TimeWait);
+        let new = Some(TcpTimestampRepr::new(101, 0));
+        assert!(!takes_syn(&mut s, &syn(REMOTE_SEQ, new)));
+        assert_eq!(s.state, State::Closed);
+
+        // A connection in another state takes a SYN of its endpoints, whatever its number.
+        let mut s = socket_established();
+        assert!(takes_syn(&mut s, &syn(REMOTE_SEQ + 1 + 1000, None)));
+        assert_eq!(s.state, State::Established);
+
+        // A listening socket takes none here, nor does a connection to other endpoints.
+        let mut s = socket_listen();
+        assert!(!takes_syn(&mut s, &syn(REMOTE_SEQ, None)));
+        assert_eq!(s.state, State::Listen);
+        let mut s = socket_time_wait(false);
+        let other_port = TcpRepr {
+            src_port: REMOTE_PORT + 1,
+            ..syn(REMOTE_SEQ + 1 + 1 + 1000, None)
+        };
+        assert!(!takes_syn(&mut s, &other_port));
+        assert_eq!(s.state, State::TimeWait);
+    }
