+    pub fn shed_buffers(&mut self) -> Option<(SocketBuffer<'a>, SocketBuffer<'a>)> {
+        if self.state != State::TimeWait {
+            return None;
+        }
+        let receive = mem::replace(&mut self.rx_buffer, SocketBuffer::new(&mut [][..]));
+        let transmit = mem::replace(&mut self.tx_buffer, SocketBuffer::new(&mut [][..]));
