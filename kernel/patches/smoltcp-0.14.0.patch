+    /// Add a socket to the set, and return its handle, or give the socket
+    /// back if the storage is fixed-size (not a `Vec`) and is full.
+    pub fn try_add<T: AnySocket<'a>>(&mut self, socket: T) -> Result<SocketHandle, T> {
+        if self.sockets.iter().all(|slot| slot.inner.is_some()) {
+            #[cfg(feature = "alloc")]
+            if let ManagedSlice::Owned(_) = self.sockets {
+                return Ok(self.add(socket));
+            }
+            return Err(socket);
+        }
+        Ok(self.add(socket))
+    }
+
+    /// Get a socket from the set by its handle, or `None` if the handle
+    /// does not refer to a socket of this set or the socket has another
+    /// type.
+    pub fn try_get<T: AnySocket<'a>>(&self, handle: SocketHandle) -> Option<&T> {
+        T::downcast(&self.sockets.get(handle.0)?.inner.as_ref()?.socket)
+    }
+
+    /// Get a mutable socket from the set by its handle, or `None` if the
+    /// handle does not refer to a socket of this set or the socket has
+    /// another type.
+    pub fn try_get_mut<T: AnySocket<'a>>(&mut self, handle: SocketHandle) -> Option<&mut T> {
+        T::downcast_mut(&mut self.sockets.get_mut(handle.0)?.inner.as_mut()?.socket)
+    }
+
+    /// Remove a socket from the set, without changing its state, or return
+    /// `None` if the handle does not refer to a socket of this set.
+    pub fn try_remove(&mut self, handle: SocketHandle) -> Option<Socket<'a>> {
+        net_trace!("[{}]: removing", handle.0);
+        Some(self.sockets.get_mut(handle.0)?.inner.take()?.socket)
+    }
